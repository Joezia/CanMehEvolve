# The FIT SDK is licensed and must never be committed. CMake fetches it while
# configuring, which is how each person accepts its license terms.
sdk/
lab/
# runs/ holds the run logs and IS tracked (results.jsonl, credits.csv, summary.json, measurements, harness output, ...); only the heavy profiler
# recordings are left out. The sampled line report (sampling/sample.txt) that the draws can be replayed from is kept.
runs/**/*perf.data*
runs/**/scratch/
data/
*.o
*.so
*.dylib
calib/
CanMehHarness
CanMehSearch
CanMehBench
CanMehCalibrate
CanMehDataGenerator
CanMehDecodeForSampler

# CMake writes the fetched SDK into whichever build directory it configured, so
# ignoring sdk/ alone is not enough and ignoring build/ alone is not enough
# either: build-check/ and build-prepipe/ have each held a copy. This glob
# covers every build directory, present and future.
build*/
_deps/

__pycache__/
