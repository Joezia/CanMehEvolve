Subject: [PATCH] Mesg::GetActiveSubFieldIndexByFieldIndex: model rewrite
 accepted by the search (generation 1)

Provenance: greedy search, seed 1, generation 1, region 242 (Mesg::GetActiveSubFieldIndexByFieldIndex).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 1.0000 -> 0.9851 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s1-1072019/patches/gen_1.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_mesg.cpp | 59 +++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 51 insertions(+), 8 deletions(-)

diff --git a/src/fit_mesg.cpp b/src/fit_mesg.cpp
index 6972b9b..30fa22a 100644
--- a/src/fit_mesg.cpp
+++ b/src/fit_mesg.cpp
@@ -377,23 +377,66 @@ FIT_UINT16 Mesg::GetActiveSubFieldIndexByFieldIndex(const FIT_UINT16 fieldIndex)
     if ((int) fieldIndex >= GetNumFields())
         return FIT_SUBFIELD_INDEX_MAIN_FIELD;
 
-    for (FIT_UINT16 i = 0; i < fields[fieldIndex].GetNumSubFields(); i++)
+    const Field& field = fields[fieldIndex];
+    const FIT_UINT16 numSubFields = field.GetNumSubFields();
+
+    if (numSubFields == 0)
+        return FIT_SUBFIELD_INDEX_MAIN_FIELD;
+
+    // Cache a few referenced-field values to avoid repeating GetField and
+    // GetFLOAT64Value for subfields that share the same reference field.
+    const Field* cachedFields[8];
+    FIT_UINT16 cachedNums[8];
+    FIT_SINT32 cachedVals[8];
+    FIT_UINT16 cacheCount = 0;
+
+    for (FIT_UINT16 i = 0; i < numSubFields; i++)
     {
-        const Profile::SUBFIELD* subField = fields[fieldIndex].GetSubField(i);
+        const Profile::SUBFIELD* subField = field.GetSubField(i);
 
         if (subField != FIT_NULL)
         {
             for (int j = 0; j < (int) subField->numMaps; j++)
             {
-                const Field* refField = GetField(subField->maps[j].refFieldNum);
+                const FIT_UINT16 refFieldNum = subField->maps[j].refFieldNum;
+
+                const Field* refField = FIT_NULL;
+                FIT_SINT32 refValueInt = 0;
+                bool cached = false;
 
-                if (refField != FIT_NULL)
+                for (FIT_UINT16 k = cacheCount; k > 0; --k)
                 {
-                    FIT_FLOAT64 refValue = refField->GetFLOAT64Value(0, FIT_SUBFIELD_INDEX_MAIN_FIELD);
-                    refValue += ((refValue >= 0.0) ? (0.5) : (-0.5));
-                    if ((FIT_SINT32)refValue == subField->maps[j].refFieldValue)
-                        return ((FIT_UINT16) i);
+                    const FIT_UINT16 idx = (FIT_UINT16)(k - 1);
+                    if (cachedNums[idx] == refFieldNum)
+                    {
+                        refField = cachedFields[idx];
+                        refValueInt = cachedVals[idx];
+                        cached = true;
+                        break;
+                    }
                 }
+
+                if (!cached)
+                {
+                    refField = GetField(refFieldNum);
+                    if (refField != FIT_NULL)
+                    {
+                        FIT_FLOAT64 refValue = refField->GetFLOAT64Value(0, FIT_SUBFIELD_INDEX_MAIN_FIELD);
+                        refValue += ((refValue >= 0.0) ? (0.5) : (-0.5));
+                        refValueInt = (FIT_SINT32)refValue;
+                    }
+
+                    if (cacheCount < 8)
+                    {
+                        cachedNums[cacheCount] = refFieldNum;
+                        cachedFields[cacheCount] = refField;
+                        cachedVals[cacheCount] = refValueInt;
+                        cacheCount++;
+                    }
+                }
+
+                if (refField != FIT_NULL && refValueInt == subField->maps[j].refFieldValue)
+                    return ((FIT_UINT16) i);
             }
         }
     }
