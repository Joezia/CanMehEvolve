From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] Field::Field: model rewrite accepted by the search
 (generation 24)

Provenance: greedy search, seed 1, generation 24, region 115 (Field::Field).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8826 -> 0.8754 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s1-1072019/patches/gen_24.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_field.cpp | 40 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/src/fit_field.cpp b/src/fit_field.cpp
index 1e4b215..e195482 100644
--- a/src/fit_field.cpp
+++ b/src/fit_field.cpp
@@ -47,11 +47,47 @@ Field::Field(const Profile::MESG_INDEX mesgIndex, const FIT_UINT16 fieldIndex)
 
 Field::Field(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
     : FieldBase()
-    , profile(Profile::GetMesg(mesgNum))
-    , profileIndex(Profile::GetFieldIndex(mesgNum, fieldNum))
+    , profile(FIT_NULL)
+    , profileIndex(FIT_UINT8_INVALID)
     , type(FIT_UINT8_INVALID)
     , isFieldExpanded(FIT_FALSE)
 {
+    static FIT_UINT16 mesgCacheKey[16];
+    static const Profile::MESG* mesgCacheProfile[16];
+    static bool mesgCacheValid[16] = {};
+
+    const int mesgCacheIdx = mesgNum & 15;
+    if (!mesgCacheValid[mesgCacheIdx] || mesgCacheKey[mesgCacheIdx] != mesgNum)
+    {
+        mesgCacheKey[mesgCacheIdx] = mesgNum;
+        mesgCacheProfile[mesgCacheIdx] = Profile::GetMesg(mesgNum);
+        mesgCacheValid[mesgCacheIdx] = true;
+    }
+    profile = mesgCacheProfile[mesgCacheIdx];
+
+    static FIT_UINT16 fieldCacheMesgNum[256];
+    static FIT_UINT8 fieldCacheIndex[256];
+    static bool fieldCacheValid[256] = {};
+
+    if (!fieldCacheValid[fieldNum] || fieldCacheMesgNum[fieldNum] != mesgNum)
+    {
+        FIT_UINT8 index = FIT_UINT8_INVALID;
+        if (profile != FIT_NULL)
+        {
+            for (FIT_UINT8 i = 0; i < profile->numFields; ++i)
+            {
+                if (profile->fields[i].num == fieldNum)
+                {
+                    index = i;
+                    break;
+                }
+            }
+        }
+        fieldCacheMesgNum[fieldNum] = mesgNum;
+        fieldCacheIndex[fieldNum] = index;
+        fieldCacheValid[fieldNum] = true;
+    }
+    profileIndex = fieldCacheIndex[fieldNum];
 }
 
 Field::Field(const std::string& mesgName, const std::string& fieldName)
