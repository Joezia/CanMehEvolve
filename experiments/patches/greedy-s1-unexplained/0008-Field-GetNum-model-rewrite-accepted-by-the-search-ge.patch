---
 src/fit_field.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/fit_field.cpp b/src/fit_field.cpp
index e195482..242a9e5 100644
--- a/src/fit_field.cpp
+++ b/src/fit_field.cpp
@@ -128,9 +128,14 @@ std::string Field::GetName() const
 
 FIT_UINT8 Field::GetNum(void) const
 {
-    if ((profile == NULL) || (profileIndex >= profile->numFields))
+    const auto *p = profile;
+    const auto index = profileIndex;
+    if (p == NULL)
+        return FIT_FIELD_NUM_INVALID;
+    const auto *fields = p->fields;
+    if (index >= p->numFields)
         return FIT_FIELD_NUM_INVALID;
-    return profile->fields[profileIndex].num;
+    return fields[index].num;
 }
 
