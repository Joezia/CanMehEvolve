---
 src/fit_field_base.cpp | 38 +++++++++++++++++++++++++++++++++-----
 1 file changed, 33 insertions(+), 5 deletions(-)

diff --git a/src/fit_field_base.cpp b/src/fit_field_base.cpp
index 427df50..47b1efc 100644
--- a/src/fit_field_base.cpp
+++ b/src/fit_field_base.cpp
@@ -16,6 +16,7 @@
 #include "fit_field_base.hpp"
 #include "fit_mesg.hpp"
 #include "fit_unicode.hpp"
+#include <cstring>
 
 namespace fit
 {
@@ -1132,17 +1133,44 @@ FIT_FLOAT64 FieldBase::Round(FIT_FLOAT64 value)
 template <typename T>
 T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
 {
-    FIT_UINT8 size = baseTypeSizes[GetType() & FIT_BASE_TYPE_NUM_MASK];
+    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;
+    const FIT_UINT8 size = baseTypeSizes[type];
     if (fieldArrayIndex >= (FIT_UINT8)values.size())
     {
-        return *reinterpret_cast<const T*>(baseTypeInvalids[GetType() & FIT_BASE_TYPE_NUM_MASK]);
+        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
     }
 
-    T rv = 0;
+    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);
 
-    for (int i = 0; i < size; i++)
+    if (size > sizeof(T))
+    {
+        T rv = 0;
+        for (int i = 0; i < size; i++)
+        {
+            rv |= static_cast<T>(p[i]) << (i * 8);
+        }
+        return rv;
+    }
+
+    T rv = 0;
+    switch (size)
     {
-        rv |= static_cast<T>(values[(fieldArrayIndex * size) + i]) << (i * 8);
+    case 0:
+        return rv;
+    case 1:
+        return static_cast<T>(p[0]);
+    case 2:
+        std::memcpy(&rv, p, 2);
+        break;
+    case 4:
+        std::memcpy(&rv, p, 4);
+        break;
+    case 8:
+        std::memcpy(&rv, p, 8);
+        break;
+    default:
+        std::memcpy(&rv, p, size);
+        break;
     }
 
     return rv;
