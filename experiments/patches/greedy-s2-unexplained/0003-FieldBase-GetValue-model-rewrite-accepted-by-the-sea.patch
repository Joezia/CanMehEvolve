Subject: [PATCH] FieldBase::GetValue: model rewrite accepted by the search
 (generation 7)

Provenance: greedy search, seed 2, generation 7, region 196 (FieldBase::GetValue).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8859 -> 0.8753 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s2-1072867/patches/gen_7.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_field_base.cpp | 35 ++++++++++++++++++++++++++++-------
 1 file changed, 28 insertions(+), 7 deletions(-)

diff --git a/src/fit_field_base.cpp b/src/fit_field_base.cpp
index f4c33d8..a21e9b6 100644
--- a/src/fit_field_base.cpp
+++ b/src/fit_field_base.cpp
@@ -16,6 +16,7 @@
 #include "fit_field_base.hpp"
 #include "fit_mesg.hpp"
 #include "fit_unicode.hpp"
+#include <cstring>
 
 namespace fit
 {
@@ -1130,20 +1131,40 @@ FIT_FLOAT64 FieldBase::Round(FIT_FLOAT64 value)
 template <typename T>
 T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
 {
-    FIT_UINT8 size = baseTypeSizes[GetType() & FIT_BASE_TYPE_NUM_MASK];
-    if (fieldArrayIndex >= (FIT_UINT8)values.size())
+    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;
+
+    if (fieldArrayIndex >= static_cast<FIT_UINT8>(values.size()))
     {
-        return *reinterpret_cast<const T*>(baseTypeInvalids[GetType() & FIT_BASE_TYPE_NUM_MASK]);
+        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
     }
 
-    T rv = 0;
+    const FIT_UINT8 size = baseTypeSizes[type];
+    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);
+    FIT_UINT64 rv = 0;
 
-    for (int i = 0; i < size; i++)
+    switch (size)
     {
-        rv |= static_cast<T>(values[(fieldArrayIndex * size) + i]) << (i * 8);
+    case 1:
+        rv = p[0];
+        break;
+    case 2:
+        std::memcpy(&rv, p, 2);
+        break;
+    case 4:
+        std::memcpy(&rv, p, 4);
+        break;
+    case 8:
+        std::memcpy(&rv, p, 8);
+        break;
+    default:
+        for (int i = 0; i < size; ++i)
+        {
+            rv |= static_cast<FIT_UINT64>(p[i]) << (i * 8);
+        }
+        break;
     }
 
-    return rv;
+    return static_cast<T>(rv);
 }
 
 
