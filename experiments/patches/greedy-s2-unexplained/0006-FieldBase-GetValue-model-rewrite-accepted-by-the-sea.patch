---
 src/fit_field_base.cpp | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/fit_field_base.cpp b/src/fit_field_base.cpp
index a21e9b6..121f95f 100644
--- a/src/fit_field_base.cpp
+++ b/src/fit_field_base.cpp
@@ -1139,14 +1139,27 @@ T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
     }
 
     const FIT_UINT8 size = baseTypeSizes[type];
-    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);
+    const FIT_UINT8* const p = values.data() + (fieldArrayIndex * size);
+
+    if (size == 1)
+    {
+        return static_cast<T>(p[0]);
+    }
+
+    if constexpr (std::is_integral<T>::value)
+    {
+        if (size == sizeof(T))
+        {
+            FIT_UINT64 rv = 0;
+            std::memcpy(&rv, p, sizeof(T));
+            return static_cast<T>(rv);
+        }
+    }
+
     FIT_UINT64 rv = 0;
 
     switch (size)
     {
-    case 1:
-        rv = p[0];
-        break;
     case 2:
         std::memcpy(&rv, p, 2);
         break;
