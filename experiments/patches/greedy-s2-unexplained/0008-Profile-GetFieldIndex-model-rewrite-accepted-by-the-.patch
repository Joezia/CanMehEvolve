From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] Profile::GetFieldIndex: model rewrite accepted by the search
 (generation 27)

Provenance: greedy search, seed 2, generation 27, region 576 (Profile::GetFieldIndex).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8713 -> 0.8552 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s2-1072867/patches/gen_27.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_profile.cpp | 46 ++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 39 insertions(+), 7 deletions(-)

diff --git a/src/fit_profile.cpp b/src/fit_profile.cpp
index 4764491..dda0365 100644
--- a/src/fit_profile.cpp
+++ b/src/fit_profile.cpp
@@ -11,6 +11,7 @@
 
 
 #include "fit_profile.hpp"
+#include <new>
 
 namespace fit
 {
@@ -3087,18 +3088,49 @@ const Profile::MESG* Profile::GetMesg(const std::string& name)
 
 const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
 {
-    const MESG *mesg = GetMesg(mesgNum);
+    static FIT_UINT16 *fieldIndex[65536] = {};
+    FIT_UINT16 *table = fieldIndex[mesgNum];
 
-    if (mesg == NULL)
-        return FIT_UINT16_INVALID;
+    if (table == NULL)
+    {
+        const MESG *mesg = GetMesg(mesgNum);
 
-    for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+        if (mesg == NULL)
+        {
+            fieldIndex[mesgNum] = reinterpret_cast<FIT_UINT16 *>(1);
+            return FIT_UINT16_INVALID;
+        }
+
+        table = new (std::nothrow) FIT_UINT16[256];
+
+        if (table == NULL)
+        {
+            for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+            {
+                if (mesg->fields[i].num == fieldNum)
+                    return i;
+            }
+            return FIT_UINT16_INVALID;
+        }
+
+        for (FIT_UINT16 i = 0; i < 256; i++)
+            table[i] = FIT_UINT16_INVALID;
+
+        for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+        {
+            const FIT_UINT8 num = mesg->fields[i].num;
+            if (table[num] == FIT_UINT16_INVALID)
+                table[num] = i;
+        }
+
+        fieldIndex[mesgNum] = table;
+    }
+    else if (table == reinterpret_cast<FIT_UINT16 *>(1))
     {
-        if (mesg->fields[i].num == fieldNum)
-            return i;
+        return FIT_UINT16_INVALID;
     }
 
-    return FIT_UINT16_INVALID;
+    return table[fieldNum];
 }
 
 const FIT_UINT16 Profile::GetFieldIndex(const std::string& mesgName, const std::string& fieldName)
