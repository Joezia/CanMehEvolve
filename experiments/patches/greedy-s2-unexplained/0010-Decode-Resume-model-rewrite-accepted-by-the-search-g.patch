From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] Decode::Resume: model rewrite accepted by the search
 (generation 37)

Provenance: greedy search, seed 2, generation 37, region 50 (Decode::Resume).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8548 -> 0.8472 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s2-1072867/patches/gen_37.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_decode.cpp | 54 ++++++++++++++++++++++++++++------------------
 1 file changed, 33 insertions(+), 21 deletions(-)

diff --git a/src/fit_decode.cpp b/src/fit_decode.cpp
index de87b06..8c1c1d5 100644
--- a/src/fit_decode.cpp
+++ b/src/fit_decode.cpp
@@ -238,42 +238,48 @@ FIT_BOOL Decode::Resume(void)
             bytesRead = (FIT_UINT32)file->gcount();
         }
 
-        for (; currentByteIndex < bytesRead; currentByteIndex++)
+        FIT_UINT32 i = currentByteIndex;
+        const FIT_UINT32 br = bytesRead;
+        for (; i < br; ++i)
         {
-            if (pause)
-                return FIT_FALSE;
+            decodeReturn = ReadByte((FIT_UINT8)buffer[i]);
 
-            decodeReturn = ReadByte((FIT_UINT8)buffer[currentByteIndex]);
+            if (__builtin_expect(decodeReturn == RETURN_CONTINUE, 1))
+            {
+                ++currentByteOffset;
+                continue;
+            }
 
-            switch (decodeReturn) {
-                case RETURN_CONTINUE:
-                    break;
+            currentByteIndex = i;
 
+            switch (decodeReturn) {
                 case RETURN_MESG:
-                    if (mesg.GetNum() == FIT_MESG_NUM_DEVELOPER_DATA_ID)
+                {
+                    const FIT_MESG_NUM mesgNum = mesg.GetNum();
+                    if (mesgNum == FIT_MESG_NUM_DEVELOPER_DATA_ID)
                     {
                         DeveloperDataIdMesg devIdMesg(mesg);
 
                         if (!devIdMesg.IsDeveloperDataIndexValid()) {
-							throw fit::RuntimeException("Invalid developer data index in DeveloperDataIdMesg");
-						}
+                            throw fit::RuntimeException("Invalid developer data index in DeveloperDataIdMesg");
+                        }
 
                         FIT_UINT8 index = devIdMesg.GetDeveloperDataIndex();
                         developers[index] = devIdMesg;
                         descriptions[index] = std::unordered_map<FIT_UINT8, FieldDescriptionMesg>();
                     }
-                    else if (mesg.GetNum() == FIT_MESG_NUM_FIELD_DESCRIPTION)
+                    else if (mesgNum == FIT_MESG_NUM_FIELD_DESCRIPTION)
                     {
                         FieldDescriptionMesg descMesg(mesg);
 
                         if (!descMesg.IsDeveloperDataIndexValid()) {
-							throw fit::RuntimeException("Invalid developer data index in FieldDescriptionMesg");
-						}
+                            throw fit::RuntimeException("Invalid developer data index in FieldDescriptionMesg");
+                        }
 
-						if (!descMesg.IsFieldDefinitionNumberValid())
-						{
-							throw fit::RuntimeException("Invalid developer field definition number in FieldDescriptionMesg");
-						}
+                        if (!descMesg.IsFieldDefinitionNumberValid())
+                        {
+                            throw fit::RuntimeException("Invalid developer field definition number in FieldDescriptionMesg");
+                        }
 
                         FIT_UINT8 index = descMesg.GetDeveloperDataIndex();
                         FIT_UINT8 fldNum = descMesg.GetFieldDefinitionNumber();
@@ -299,6 +305,7 @@ FIT_BOOL Decode::Resume(void)
                     if (mesgListener)
                         mesgListener->OnMesg(mesg);
                     break;
+                }
 
                 case RETURN_MESG_DEF:
                    
@@ -310,15 +317,20 @@ FIT_BOOL Decode::Resume(void)
 
                 case RETURN_END_OF_FILE:
                      // Increment so we do not read the same byte twice in the case of a chained file
-                    currentByteIndex++;
-                    currentByteOffset++;
+                    currentByteIndex = i + 1;
+                    ++currentByteOffset;
                     return FIT_TRUE;
 
                 default:
-                    currentByteOffset++;
+                    ++currentByteOffset;
                     return FIT_TRUE;
             }
-            currentByteOffset++;
+            ++currentByteOffset;
+            if (__builtin_expect(pause, 0))
+            {
+                currentByteIndex = i + 1;
+                return FIT_FALSE;
+            }
         }
         currentByteIndex = 0;
     } while ( file->good() );
