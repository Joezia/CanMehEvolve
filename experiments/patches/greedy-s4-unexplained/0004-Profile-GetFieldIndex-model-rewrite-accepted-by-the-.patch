Subject: [PATCH] Profile::GetFieldIndex: model rewrite accepted by the search
 (generation 9)

Provenance: greedy search, seed 4, generation 9, region 576 (Profile::GetFieldIndex).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.9110 -> 0.8964 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s4-1072871/patches/gen_9.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_profile.cpp | 47 ++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 40 insertions(+), 7 deletions(-)

diff --git a/src/fit_profile.cpp b/src/fit_profile.cpp
index 4898475..56adfe5 100644
--- a/src/fit_profile.cpp
+++ b/src/fit_profile.cpp
@@ -3085,18 +3085,51 @@ const Profile::MESG* Profile::GetMesg(const std::string& name)
 
 const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
 {
-    const MESG *mesg = GetMesg(mesgNum);
+    const FIT_UINT32 key = (static_cast<FIT_UINT32>(mesgNum) << 8) | fieldNum;
+    const FIT_UINT32 storedKey = key + 1;
 
-    if (mesg == NULL)
-        return FIT_UINT16_INVALID;
+    static FIT_UINT32 cachedKeys[2048] = {};
+    static FIT_UINT16 cachedValues[2048] = {};
 
-    for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+    const FIT_UINT32 slot = (key * 2654435761u) >> 21;
+    if (cachedKeys[slot] == storedKey)
+        return cachedValues[slot];
+
+    static FIT_UINT16 lastMesgNum = 0;
+    static const MESG *lastMesg = NULL;
+
+    const MESG *mesg;
+    if (lastMesg != NULL && mesgNum == lastMesgNum)
     {
-        if (mesg->fields[i].num == fieldNum)
-            return i;
+        mesg = lastMesg;
+    }
+    else
+    {
+        mesg = GetMesg(mesgNum);
+        if (mesg != NULL)
+        {
+            lastMesgNum = mesgNum;
+            lastMesg = mesg;
+        }
     }
 
-    return FIT_UINT16_INVALID;
+    FIT_UINT16 result = FIT_UINT16_INVALID;
+
+    if (mesg != NULL)
+    {
+        for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+        {
+            if (mesg->fields[i].num == fieldNum)
+            {
+                result = i;
+                break;
+            }
+        }
+    }
+
+    cachedKeys[slot] = storedKey;
+    cachedValues[slot] = result;
+    return result;
 }
 
 const FIT_UINT16 Profile::GetFieldIndex(const std::string& mesgName, const std::string& fieldName)
