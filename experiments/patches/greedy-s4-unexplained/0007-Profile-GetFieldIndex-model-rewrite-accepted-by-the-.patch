 src/fit_profile.cpp | 58 +++++++++++++++++++++------------------------
 1 file changed, 27 insertions(+), 31 deletions(-)

diff --git a/src/fit_profile.cpp b/src/fit_profile.cpp
index 56adfe5..3b6c2b2 100644
--- a/src/fit_profile.cpp
+++ b/src/fit_profile.cpp
@@ -3085,51 +3085,47 @@ const Profile::MESG* Profile::GetMesg(const std::string& name)
 
 const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
 {
-    const FIT_UINT32 key = (static_cast<FIT_UINT32>(mesgNum) << 8) | fieldNum;
-    const FIT_UINT32 storedKey = key + 1;
+    static FIT_UINT16* fieldTables[65536] = {};
+    static FIT_UINT16* invalidTable = NULL;
 
-    static FIT_UINT32 cachedKeys[2048] = {};
-    static FIT_UINT16 cachedValues[2048] = {};
-
-    const FIT_UINT32 slot = (key * 2654435761u) >> 21;
-    if (cachedKeys[slot] == storedKey)
-        return cachedValues[slot];
-
-    static FIT_UINT16 lastMesgNum = 0;
-    static const MESG *lastMesg = NULL;
-
-    const MESG *mesg;
-    if (lastMesg != NULL && mesgNum == lastMesgNum)
+    FIT_UINT16* table = fieldTables[mesgNum];
+    if (table != NULL)
     {
-        mesg = lastMesg;
+        return table[fieldNum];
     }
-    else
+
+    const MESG *mesg = GetMesg(mesgNum);
+    if (mesg == NULL)
     {
-        mesg = GetMesg(mesgNum);
-        if (mesg != NULL)
+        if (invalidTable == NULL)
         {
-            lastMesgNum = mesgNum;
-            lastMesg = mesg;
+            invalidTable = new FIT_UINT16[256];
+            for (FIT_UINT16 i = 0; i < 256; i++)
+            {
+                invalidTable[i] = FIT_UINT16_INVALID;
+            }
         }
+        fieldTables[mesgNum] = invalidTable;
+        return FIT_UINT16_INVALID;
     }
 
-    FIT_UINT16 result = FIT_UINT16_INVALID;
+    table = new FIT_UINT16[256];
+    for (FIT_UINT16 i = 0; i < 256; i++)
+    {
+        table[i] = FIT_UINT16_INVALID;
+    }
 
-    if (mesg != NULL)
+    for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
     {
-        for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+        const FIT_UINT16 num = mesg->fields[i].num;
+        if (num < 256 && table[num] == FIT_UINT16_INVALID)
         {
-            if (mesg->fields[i].num == fieldNum)
-            {
-                result = i;
-                break;
-            }
+            table[num] = i;
         }
     }
 
-    cachedKeys[slot] = storedKey;
-    cachedValues[slot] = result;
-    return result;
+    fieldTables[mesgNum] = table;
+    return table[fieldNum];
 }
 
 const FIT_UINT16 Profile::GetFieldIndex(const std::string& mesgName, const std::string& fieldName)
