Subject: [PATCH] Mesg::GetField: model rewrite accepted by the search
 (generation 31)

Provenance: greedy search, seed 4, generation 31, region 234 (Mesg::GetField).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8494 -> 0.8446 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s4-1072871/patches/gen_31.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_mesg.cpp | 26 +++++++++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/src/fit_mesg.cpp b/src/fit_mesg.cpp
index 8eaebf1..7b8062c 100644
--- a/src/fit_mesg.cpp
+++ b/src/fit_mesg.cpp
@@ -250,10 +250,30 @@ Field* Mesg::GetFieldByIndex(const FIT_UINT16 index)
 
 Field* Mesg::GetField(const FIT_UINT8 fieldNum)
 {
-    for (Field& field : fields)
+    Field* field = fields.data();
+    auto count = fields.size();
+
+    while (count >= 4)
+    {
+        if (*reinterpret_cast<const FIT_UINT8*>(field) == fieldNum)
+            return field;
+        if (*reinterpret_cast<const FIT_UINT8*>(field + 1) == fieldNum)
+            return field + 1;
+        if (*reinterpret_cast<const FIT_UINT8*>(field + 2) == fieldNum)
+            return field + 2;
+        if (*reinterpret_cast<const FIT_UINT8*>(field + 3) == fieldNum)
+            return field + 3;
+
+        field += 4;
+        count -= 4;
+    }
+
+    while (count > 0)
     {
-        if (field.GetNum() == fieldNum)
-            return &field;
+        if (*reinterpret_cast<const FIT_UINT8*>(field) == fieldNum)
+            return field;
+        ++field;
+        --count;
     }
 
     return FIT_NULL;
