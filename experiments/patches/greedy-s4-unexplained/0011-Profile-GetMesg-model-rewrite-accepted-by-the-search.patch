---
 src/fit_profile.cpp | 17 ++++++++---------
 1 file changed, 8 insertions(+), 9 deletions(-)

diff --git a/src/fit_profile.cpp b/src/fit_profile.cpp
index 3b6c2b2..e954c45 100644
--- a/src/fit_profile.cpp
+++ b/src/fit_profile.cpp
@@ -3057,19 +3057,18 @@ const Profile::MESG Profile::mesgs[MESGS] =
 
 const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
 {
-    static const Profile::MESG* table[65536] = {};
-    static bool initialized = false;
-
-    if (!initialized)
-    {
+    static FIT_UINT16 slot[65536] = {};
+    static const bool initialized = [] {
         for (int i = static_cast<int>(MESGS) - 1; i >= 0; --i)
         {
-            table[mesgs[i].num] = &mesgs[i];
+            slot[mesgs[i].num] = static_cast<FIT_UINT16>(i + 1);
         }
-        initialized = true;
-    }
+        return true;
+    }();
+    (void)initialized;
 
-    return table[num];
+    const FIT_UINT16 s = slot[num];
+    return (s != 0) ? &mesgs[s - 1] : NULL;
 }
 
