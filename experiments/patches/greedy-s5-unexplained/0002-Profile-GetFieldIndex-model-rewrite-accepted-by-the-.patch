From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] Profile::GetFieldIndex: model rewrite accepted by the search
 (generation 6)

Provenance: greedy search, seed 5, generation 6, region 576 (Profile::GetFieldIndex).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.9457 -> 0.8961 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s5-1072873/patches/gen_6.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_profile.cpp | 51 ++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 46 insertions(+), 5 deletions(-)

diff --git a/src/fit_profile.cpp b/src/fit_profile.cpp
index d7551dd..e2b8767 100644
--- a/src/fit_profile.cpp
+++ b/src/fit_profile.cpp
@@ -3079,15 +3079,56 @@ const Profile::MESG* Profile::GetMesg(const std::string& name)
 
 const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
 {
-    const MESG *mesg = GetMesg(mesgNum);
+    struct CacheEntry
+    {
+        FIT_UINT16 mesgNum;
+        FIT_UINT16 state;
+        const MESG *mesg;
+        FIT_UINT16 index[256];
+    };
 
-    if (mesg == NULL)
+    static CacheEntry cache[16] = {};
+
+    CacheEntry &e = cache[mesgNum & 15];
+
+    if (e.state == 2 && e.mesgNum == mesgNum)
+    {
+        return e.mesg ? e.index[fieldNum] : FIT_UINT16_INVALID;
+    }
+
+    if (e.state != 0 && e.mesgNum == mesgNum)
+    {
+        if (e.mesg != NULL)
+        {
+            for (int i = 0; i < 256; ++i)
+                e.index[i] = FIT_UINT16_INVALID;
+
+            const MESG *mesg = e.mesg;
+            for (FIT_UINT16 i = 0; i < mesg->numFields; ++i)
+            {
+                const FIT_UINT8 num = mesg->fields[i].num;
+                if (e.index[num] == FIT_UINT16_INVALID)
+                    e.index[num] = i;
+            }
+        }
+        e.state = 2;
+        return e.mesg ? e.index[fieldNum] : FIT_UINT16_INVALID;
+    }
+
+    e.mesgNum = mesgNum;
+    e.state = 1;
+    e.mesg = GetMesg(mesgNum);
+
+    if (e.mesg == NULL)
         return FIT_UINT16_INVALID;
 
-    for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+    const MESG *mesg = e.mesg;
+    const FIELD *field = mesg->fields;
+    const FIELD *end = field + mesg->numFields;
+    for (; field != end; ++field)
     {
-        if (mesg->fields[i].num == fieldNum)
-            return i;
+        if (field->num == fieldNum)
+            return static_cast<FIT_UINT16>(field - mesg->fields);
     }
 
     return FIT_UINT16_INVALID;
