From 46abe5c74d5f3e3d3e95c6741029a4794d46de46 Mon Sep 17 00:00:00 2001
From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] MesgBroadcaster::RemoveListener(HrvValue): erase by
 hand-written compaction

What: replaces std::find + vector::erase with a manual pointer scan and a shift-down, then pop_back.
Why it might be faster: it avoids the generic algorithm and erase machinery. Honest note: this function is a listener-registry call, not on the per-record decode path, so the 0.1% search-time step is most likely noise that the ordering heuristic accepted. Keep it only as part of the series, not as evidence of a real gain.

Provenance: greedy search, seed 3, generation 6, region 515 (MesgBroadcaster::RemoveListener).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 1.0000 -> 0.9990 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s3-1072869/patches/gen_6.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_mesg_broadcaster.cpp | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/fit_mesg_broadcaster.cpp b/src/fit_mesg_broadcaster.cpp
index b7d9b28..6cd8362 100644
--- a/src/fit_mesg_broadcaster.cpp
+++ b/src/fit_mesg_broadcaster.cpp
@@ -1532,9 +1532,18 @@ void MesgBroadcaster::AddListener(HrvValueMesgListener& hrvValueMesgListener)
 
 void MesgBroadcaster::RemoveListener(HrvValueMesgListener& hrvValueMesgListener)
 {
-    std::vector<HrvValueMesgListener *>::iterator it = std::find(hrvValueMesgListeners.begin(), hrvValueMesgListeners.end(), &hrvValueMesgListener);
-    if (hrvValueMesgListeners.end() != it)
-    hrvValueMesgListeners.erase(it);
+    HrvValueMesgListener **begin = hrvValueMesgListeners.data();
+    HrvValueMesgListener **end = begin + hrvValueMesgListeners.size();
+    HrvValueMesgListener **it = begin;
+    while (it != end && *it != &hrvValueMesgListener)
+        ++it;
+    if (it != end)
+    {
+        HrvValueMesgListener **src = it + 1;
+        while (src != end)
+            *it++ = *src++;
+        hrvValueMesgListeners.pop_back();
+    }
 }
 
 
