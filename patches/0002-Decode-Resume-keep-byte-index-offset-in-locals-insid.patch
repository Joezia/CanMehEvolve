From 79baa81efe51a653547252d38c4e15de727a9c73 Mon Sep 17 00:00:00 2001
From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] Decode::Resume: keep byte index/offset in locals inside the
 read loop

What: copies currentByteIndex/currentByteOffset into local variables for the per-byte loop and writes them back only when control leaves the loop (message, pause, end of file). Also re-indents tab-indented lines.
Why it might be faster: members are reloaded and stored on every byte because ReadByte may alias them; locals can stay in registers. The step measured 0.4% at search time, i.e. close to the instrument's noise floor.
Risk: the pause/resume bookkeeping is rewritten; the harness checksum matched, but only the benchmark files were exercised.

Provenance: greedy search, seed 3, generation 11, region 50 (Decode::Resume).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.9990 -> 0.9953 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s3-1072869/patches/gen_11.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_decode.cpp | 68 +++++++++++++++++++++++++++++++++-------------
 1 file changed, 49 insertions(+), 19 deletions(-)

diff --git a/src/fit_decode.cpp b/src/fit_decode.cpp
index de87b06..57e8f4f 100644
--- a/src/fit_decode.cpp
+++ b/src/fit_decode.cpp
@@ -238,25 +238,39 @@ FIT_BOOL Decode::Resume(void)
             bytesRead = (FIT_UINT32)file->gcount();
         }
 
-        for (; currentByteIndex < bytesRead; currentByteIndex++)
+        FIT_UINT32 i = currentByteIndex;
+        const FIT_UINT32 n = bytesRead;
+        FIT_UINT32 offset = currentByteOffset;
+
+        if ( (i < n) && pause )
         {
-            if (pause)
-                return FIT_FALSE;
+            currentByteIndex = i;
+            currentByteOffset = offset;
+            return FIT_FALSE;
+        }
 
-            decodeReturn = ReadByte((FIT_UINT8)buffer[currentByteIndex]);
+        for ( ; i < n; ++i )
+        {
+            decodeReturn = ReadByte((FIT_UINT8)buffer[i]);
 
-            switch (decodeReturn) {
-                case RETURN_CONTINUE:
-                    break;
+            if ( decodeReturn == RETURN_CONTINUE )
+            {
+                ++offset;
+                continue;
+            }
+
+            currentByteIndex = i;
+            currentByteOffset = offset;
 
+            switch (decodeReturn) {
                 case RETURN_MESG:
                     if (mesg.GetNum() == FIT_MESG_NUM_DEVELOPER_DATA_ID)
                     {
                         DeveloperDataIdMesg devIdMesg(mesg);
 
                         if (!devIdMesg.IsDeveloperDataIndexValid()) {
-							throw fit::RuntimeException("Invalid developer data index in DeveloperDataIdMesg");
-						}
+                            throw fit::RuntimeException("Invalid developer data index in DeveloperDataIdMesg");
+                        }
 
                         FIT_UINT8 index = devIdMesg.GetDeveloperDataIndex();
                         developers[index] = devIdMesg;
@@ -267,13 +281,13 @@ FIT_BOOL Decode::Resume(void)
                         FieldDescriptionMesg descMesg(mesg);
 
                         if (!descMesg.IsDeveloperDataIndexValid()) {
-							throw fit::RuntimeException("Invalid developer data index in FieldDescriptionMesg");
-						}
+                            throw fit::RuntimeException("Invalid developer data index in FieldDescriptionMesg");
+                        }
 
-						if (!descMesg.IsFieldDefinitionNumberValid())
-						{
-							throw fit::RuntimeException("Invalid developer field definition number in FieldDescriptionMesg");
-						}
+                        if (!descMesg.IsFieldDefinitionNumberValid())
+                        {
+                            throw fit::RuntimeException("Invalid developer field definition number in FieldDescriptionMesg");
+                        }
 
                         FIT_UINT8 index = descMesg.GetDeveloperDataIndex();
                         FIT_UINT8 fldNum = descMesg.GetFieldDefinitionNumber();
@@ -310,17 +324,33 @@ FIT_BOOL Decode::Resume(void)
 
                 case RETURN_END_OF_FILE:
                      // Increment so we do not read the same byte twice in the case of a chained file
-                    currentByteIndex++;
-                    currentByteOffset++;
+                    currentByteIndex = i + 1;
+                    currentByteOffset = offset + 1;
                     return FIT_TRUE;
 
                 default:
-                    currentByteOffset++;
+                    currentByteOffset = offset + 1;
                     return FIT_TRUE;
             }
-            currentByteOffset++;
+
+            ++offset;
+            currentByteIndex = i + 1;
+            currentByteOffset = offset;
+
+            if ( pause )
+            {
+                if ( i + 1 < n )
+                {
+                    currentByteIndex = i + 1;
+                    currentByteOffset = offset;
+                    return FIT_FALSE;
+                }
+                break;
+            }
         }
+
         currentByteIndex = 0;
+        currentByteOffset = offset;
     } while ( file->good() );
 
     if ((streamIsComplete == FIT_TRUE) && (skipHeader == FIT_FALSE))
-- 
