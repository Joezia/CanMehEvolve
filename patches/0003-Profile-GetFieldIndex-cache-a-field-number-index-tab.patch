From 0aeaa12f206efc80440767ebe24d1e4be5875600 Mon Sep 17 00:00:00 2001
From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] Profile::GetFieldIndex: cache a field-number -> index table
 for the last message

What: keeps a function-local static table (256 entries + presence bitmap) for the most recently queried message and answers repeated queries in O(1) instead of scanning mesg->fields.
Why it might be faster: the decoder asks for the same message's field indices over and over; the linear scan becomes a bit test and an array read.
Risk: the cache is unsynchronised static state, so concurrent callers from several threads would race. The benchmark is single-threaded and the checksum matched; thread safety was not tested.

Provenance: greedy search, seed 3, generation 12, region 576 (Profile::GetFieldIndex).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.9953 -> 0.9804 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s3-1072869/patches/gen_12.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_profile.cpp | 38 +++++++++++++++++++++++++++++++++++---
 1 file changed, 35 insertions(+), 3 deletions(-)

diff --git a/src/fit_profile.cpp b/src/fit_profile.cpp
index d7551dd..87c099a 100644
--- a/src/fit_profile.cpp
+++ b/src/fit_profile.cpp
@@ -3084,12 +3084,44 @@ const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT
     if (mesg == NULL)
         return FIT_UINT16_INVALID;
 
-    for (FIT_UINT16 i = 0; i < mesg->numFields; i++)
+    static const MESG *cachedMesg = NULL;
+    static FIT_UINT16 cachedFieldIndex[256];
+    static FIT_UINT32 cachedFieldMask[8];
+
+    if (mesg == cachedMesg)
     {
-        if (mesg->fields[i].num == fieldNum)
-            return i;
+        const FIT_UINT32 word = static_cast<FIT_UINT32>(fieldNum) >> 5;
+        const FIT_UINT32 bit = static_cast<FIT_UINT32>(1) << (fieldNum & 31);
+        if (cachedFieldMask[word] & bit)
+            return cachedFieldIndex[fieldNum];
+        return FIT_UINT16_INVALID;
     }
 
+    cachedMesg = mesg;
+    for (FIT_UINT32 w = 0; w < 8; ++w)
+        cachedFieldMask[w] = 0;
+
+    const FIT_UINT16 numFields = mesg->numFields;
+    for (FIT_UINT16 i = 0; i < numFields; ++i)
+    {
+        const FIT_UINT32 n = static_cast<FIT_UINT32>(mesg->fields[i].num);
+        if (n < 256)
+        {
+            const FIT_UINT32 word = n >> 5;
+            const FIT_UINT32 bit = static_cast<FIT_UINT32>(1) << (n & 31);
+            if ((cachedFieldMask[word] & bit) == 0)
+            {
+                cachedFieldMask[word] |= bit;
+                cachedFieldIndex[n] = i;
+            }
+        }
+    }
+
+    const FIT_UINT32 word = static_cast<FIT_UINT32>(fieldNum) >> 5;
+    const FIT_UINT32 bit = static_cast<FIT_UINT32>(1) << (fieldNum & 31);
+    if (cachedFieldMask[word] & bit)
+        return cachedFieldIndex[fieldNum];
+
     return FIT_UINT16_INVALID;
 }
 
