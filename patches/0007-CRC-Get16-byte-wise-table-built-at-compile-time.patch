From c30099e9cfa25e387927c5e0611d9dee6f2660a9 Mon Sep 17 00:00:00 2001
From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] CRC::Get16: byte-wise table built at compile time

What: replaces the two-nibble, 16-entry table with a 256-entry constexpr table (same CRC-16, polynomial 0xA001) and processes one byte per lookup.
Why it might be faster: half the table lookups and no nibble shuffling per byte; CRC runs over every file byte. Step measured 0.25% (small). Checksum identical.

Provenance: greedy search, seed 3, generation 20, region 26 (CRC::Get16).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8792 -> 0.8770 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s3-1072869/patches/gen_20.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_crc.cpp | 34 ++++++++++++++++------------------
 1 file changed, 16 insertions(+), 18 deletions(-)

diff --git a/src/fit_crc.cpp b/src/fit_crc.cpp
index 719892b..03e451d 100644
--- a/src/fit_crc.cpp
+++ b/src/fit_crc.cpp
@@ -17,24 +17,22 @@ namespace fit
 
 FIT_UINT16 CRC::Get16(FIT_UINT16 crc, FIT_UINT8 byte)
 {
-   static const FIT_UINT16 crc_table[16] =
-   {
-      0x0000, 0xCC01, 0xD801, 0x1400, 0xF001, 0x3C00, 0x2800, 0xE401,
-      0xA001, 0x6C00, 0x7800, 0xB401, 0x5000, 0x9C01, 0x8801, 0x4400
-   };
-   FIT_UINT16 tmp;
-
-   // compute checksum of lower four bits of byte
-   tmp = crc_table[crc & 0xF];
-   crc  = (crc >> 4) & 0x0FFF;
-   crc  = crc ^ tmp ^ crc_table[byte & 0xF];
-
-   // now compute checksum of upper four bits of byte
-   tmp = crc_table[crc & 0xF];
-   crc  = (crc >> 4) & 0x0FFF;
-   crc  = crc ^ tmp ^ crc_table[(byte >> 4) & 0xF];
-
-   return crc;
+   static constexpr auto crc_table = [] {
+      struct Table { FIT_UINT16 v[256]; };
+      Table t{};
+      for (int i = 0; i < 256; ++i)
+      {
+         FIT_UINT16 c = static_cast<FIT_UINT16>(i);
+         for (int j = 0; j < 8; ++j)
+         {
+            c = static_cast<FIT_UINT16>((c & 1) ? ((c >> 1) ^ 0xA001) : (c >> 1));
+         }
+         t.v[i] = c;
+      }
+      return t;
+   }();
+
+   return static_cast<FIT_UINT16>((crc >> 8) ^ crc_table.v[(crc ^ byte) & 0xFF]);
 }
 
 FIT_UINT16 CRC::Calc16(const volatile void *data, FIT_UINT32 size)
