From c82961960525a0194d165676bd0a71e2c0f814cb Mon Sep 17 00:00:00 2001
From: CanMehEvolve <noreply@example.com>
Date: Wed, 4 Nov 2026 12:00:00 +0800
Subject: [PATCH] FieldBase::GetValue<T>: read fixed-size values with memcpy

What: switches on the element size (1, 2, 4, 8 bytes) and loads the value with one memcpy instead of assembling it byte by byte in a loop; keeps the old loop as the fallback.
Why it might be faster: one load instead of up to eight shift/or steps per value (about 0.7% at search time).
Risk: assumes a little-endian host (the original loop was endian-independent); true for the x86-64 nodes used here. Adds #include <cstring>.

Provenance: greedy search, seed 3, generation 31, region 196 (FieldBase::GetValue).
Generated by the model (deepseek-v4.1-flash); not hand-written. Search-time ratio R (candidate/stock, <1 is faster): 0.8635 -> 0.8576 at acceptance (max of two measurements). This is a ranking value, NOT an independent per-patch
confirmation; only the fixed FINAL patch of the run was re-measured independently.
Cumulative patch it was derived from: runs/deepseek/greedy-s3-1072869/patches/gen_31.patch (diff against stock; do not apply together with the others).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/fit_field_base.cpp | 43 +++++++++++++++++++++++++++++++++++-------
 1 file changed, 36 insertions(+), 7 deletions(-)

diff --git a/src/fit_field_base.cpp b/src/fit_field_base.cpp
index f4c33d8..5038b1c 100644
--- a/src/fit_field_base.cpp
+++ b/src/fit_field_base.cpp
@@ -16,6 +16,7 @@
 #include "fit_field_base.hpp"
 #include "fit_mesg.hpp"
 #include "fit_unicode.hpp"
+#include <cstring>
 
 namespace fit
 {
@@ -1130,20 +1131,48 @@ FIT_FLOAT64 FieldBase::Round(FIT_FLOAT64 value)
 template <typename T>
 T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
 {
-    FIT_UINT8 size = baseTypeSizes[GetType() & FIT_BASE_TYPE_NUM_MASK];
+    const FIT_UINT8 baseType = static_cast<FIT_UINT8>(GetType() & FIT_BASE_TYPE_NUM_MASK);
+
     if (fieldArrayIndex >= (FIT_UINT8)values.size())
     {
-        return *reinterpret_cast<const T*>(baseTypeInvalids[GetType() & FIT_BASE_TYPE_NUM_MASK]);
+        return *reinterpret_cast<const T*>(baseTypeInvalids[baseType]);
     }
 
-    T rv = 0;
+    const FIT_UINT8 size = baseTypeSizes[baseType];
+    const FIT_UINT8* p = values.data() + static_cast<size_t>(fieldArrayIndex) * size;
 
-    for (int i = 0; i < size; i++)
+    switch (size)
     {
-        rv |= static_cast<T>(values[(fieldArrayIndex * size) + i]) << (i * 8);
+        case 1:
+            return static_cast<T>(p[0]);
+        case 2:
+        {
+            FIT_UINT16 v;
+            std::memcpy(&v, p, sizeof(v));
+            return static_cast<T>(v);
+        }
+        case 4:
+        {
+            FIT_UINT32 v;
+            std::memcpy(&v, p, sizeof(v));
+            return static_cast<T>(v);
+        }
+        case 8:
+        {
+            FIT_UINT64 v;
+            std::memcpy(&v, p, sizeof(v));
+            return static_cast<T>(v);
+        }
+        default:
+        {
+            T rv = 0;
+            for (int i = 0; i < size; i++)
+            {
+                rv |= static_cast<T>(p[i]) << (i * 8);
+            }
+            return rv;
+        }
     }
-
-    return rv;
 }
 
 
