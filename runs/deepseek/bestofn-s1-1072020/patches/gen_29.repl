I replaced the O(MESGS) linear scan with a lazily-built direct lookup table indexed by message number, so each lookup is a single array read plus a null check instead of up to ~100 comparisons.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static FIT_UINT16 index[65536];
    static bool initialized = false;
    if (!initialized)
    {
        for (int i = 0; i < MESGS; i++)
        {
            const FIT_UINT16 n = mesgs[i].num;
            if (index[n] == 0)
                index[n] = static_cast<FIT_UINT16>(i + 1);
        }
        initialized = true;
    }

    const FIT_UINT16 v = index[num];
    return v ? &mesgs[v - 1] : NULL;
}
```