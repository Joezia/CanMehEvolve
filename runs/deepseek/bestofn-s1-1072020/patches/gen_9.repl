Replaced the linear scan with a lazily built open-addressed hash table, so repeated profile lookups become O(1) and the first call only pays a small one-time build cost.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const Profile::MESG* table[8192];
    static FIT_UINT16 keys[8192];
    static bool init = false;

    if (!init)
    {
        for (int i = 0; i < MESGS; ++i)
        {
            const FIT_UINT16 n = mesgs[i].num;
            unsigned h = (static_cast<unsigned>(n) * 2654435761u) >> 19;
            while (table[h] != NULL)
                h = (h + 1) & 8191;
            keys[h] = n;
            table[h] = &mesgs[i];
        }
        init = true;
    }

    const FIT_UINT16 n = num;
    unsigned h = (static_cast<unsigned>(n) * 2654435761u) >> 19;
    for (;;)
    {
        const Profile::MESG* p = table[h];
        if (p == NULL)
            return NULL;
        if (keys[h] == n)
            return p;
        h = (h + 1) & 8191;
    }
}
```