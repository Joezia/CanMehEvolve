--- a/src/fit_field_base.cpp
+++ b/src/fit_field_base.cpp
@@ -105,8 +105,25 @@
     if (!IsValid())
         return 0;
 
-    if (GetType() != FIT_BASE_TYPE_STRING)
-        return (FIT_UINT8)(values.size() / baseTypeSizes[GetType() & FIT_BASE_TYPE_NUM_MASK]);
+    const FIT_BASE_TYPE type = GetType();
+    if (type != FIT_BASE_TYPE_STRING)
+    {
+        const auto numBytes = values.size();
+        const FIT_UINT8 index = type & FIT_BASE_TYPE_NUM_MASK;
+        switch (index)
+        {
+            case 0x00: case 0x01: case 0x02: case 0x07: case 0x0A: case 0x0D:
+                return (FIT_UINT8)numBytes;
+            case 0x03: case 0x04: case 0x0B:
+                return (FIT_UINT8)(numBytes >> 1);
+            case 0x05: case 0x06: case 0x08: case 0x0C:
+                return (FIT_UINT8)(numBytes >> 2);
+            case 0x09: case 0x0E: case 0x0F:
+                return (FIT_UINT8)(numBytes >> 3);
+            default:
+                return (FIT_UINT8)(numBytes / baseTypeSizes[index]);
+        }
+    }
 
     return (FIT_UINT8)stringIndexes.size();
 }
