I cached the base-type index and replaced the byte-by-byte shift/OR loop with fixed-width loads for the common 1/2/4/8-byte cases, keeping the original loop as a fallback for unusual widths or narrower destinations. This removes repeated `GetType()` calls and per-byte shifting from the hot path.

```include
#include <cstring>
```

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 baseType = GetType() & FIT_BASE_TYPE_NUM_MASK;
    const FIT_UINT8 size = baseTypeSizes[baseType];

    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[baseType]);
    }

    const FIT_UINT8* p = &values[fieldArrayIndex * size];

    if (size <= sizeof(T))
    {
        T rv = 0;
        switch (size)
        {
        case 1:
            rv = static_cast<T>(p[0]);
            break;
        case 2:
        {
            FIT_UINT16 v;
            std::memcpy(&v, p, 2);
            rv = static_cast<T>(v);
            break;
        }
        case 4:
        {
            FIT_UINT32 v;
            std::memcpy(&v, p, 4);
            rv = static_cast<T>(v);
            break;
        }
        case 8:
        {
            FIT_UINT64 v;
            std::memcpy(&v, p, 8);
            rv = static_cast<T>(v);
            break;
        }
        default:
            for (int i = 0; i < size; i++)
            {
                rv |= static_cast<T>(p[i]) << (i * 8);
            }
            break;
        }
        return rv;
    }

    T rv = 0;
    for (int i = 0; i < size; i++)
    {
        rv |= static_cast<T>(p[i]) << (i * 8);
    }
    return rv;
}
```