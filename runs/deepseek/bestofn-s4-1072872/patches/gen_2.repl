Replaced the linear scan with a zero-initialized 65536-entry index table built once from the profile, preserving the first match for duplicate numbers. Lookups become a single table access instead of scanning up to MESGS entries.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static FIT_UINT16 table[65536] = {};
    static bool initialized = false;

    if (!initialized)
    {
        for (int i = 0; i < MESGS; ++i)
        {
            if (table[mesgs[i].num] == 0)
                table[mesgs[i].num] = static_cast<FIT_UINT16>(i + 1);
        }
        initialized = true;
    }

    const FIT_UINT16 v = table[num];
    return v ? &mesgs[v - 1] : NULL;
}
```