I replaced the linear scan with a lazily built 65536-entry pointer lookup table keyed by message number, filling it in reverse to preserve first-match semantics. This makes every lookup a single array read instead of scanning the large message array.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const auto lookup = []() {
        static const Profile::MESG* table[65536] = {};
        int i = static_cast<int>(MESGS);
        while (i-- > 0)
        {
            table[mesgs[i].num] = &mesgs[i];
        }
        return table;
    }();

    return lookup[num];
}
```