Cached the masked base type, moved the size lookup to the valid path, and replaced the byte loop with fixed-size loads for the common 1/2/4/8-byte base types. This removes a repeated GetType call and most loop overhead.

```include
#include <cstring>
```

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;
    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
    }

    const FIT_UINT8 size = baseTypeSizes[type];
    const FIT_UINT8* p = &values[fieldArrayIndex * size];
    T rv = 0;

    switch (size)
    {
    case 1:
        rv = static_cast<T>(p[0]);
        break;
    case 2:
        if constexpr (sizeof(T) >= 2)
        {
            FIT_UINT16 v;
            std::memcpy(&v, p, 2);
            rv = static_cast<T>(v);
        }
        else
        {
            for (int i = 0; i < size; i++)
            {
                rv |= static_cast<T>(p[i]) << (i * 8);
            }
        }
        break;
    case 4:
        if constexpr (sizeof(T) >= 4)
        {
            FIT_UINT32 v;
            std::memcpy(&v, p, 4);
            rv = static_cast<T>(v);
        }
        else
        {
            for (int i = 0; i < size; i++)
            {
                rv |= static_cast<T>(p[i]) << (i * 8);
            }
        }
        break;
    case 8:
        if constexpr (sizeof(T) >= 8)
        {
            FIT_UINT64 v;
            std::memcpy(&v, p, 8);
            rv = static_cast<T>(v);
        }
        else
        {
            for (int i = 0; i < size; i++)
            {
                rv |= static_cast<T>(p[i]) << (i * 8);
            }
        }
        break;
    default:
        for (int i = 0; i < size; i++)
        {
            rv |= static_cast<T>(p[i]) << (i * 8);
        }
        break;
    }

    return rv;
}
```