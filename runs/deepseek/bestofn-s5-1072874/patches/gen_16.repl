Replaced the linear scan with a lazily built direct lookup table, preserving the first matching entry and returning NULL for unknown numbers. This makes each subsequent lookup O(1) instead of scanning the message array.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static FIT_UINT16 lookup[65536];
    static bool initialized = false;

    if (!initialized)
    {
        for (int i = 0; i < MESGS; i++)
        {
            if (lookup[mesgs[i].num] == 0)
                lookup[mesgs[i].num] = static_cast<FIT_UINT16>(i + 1);
        }
        initialized = true;
    }

    const FIT_UINT16 idx = lookup[num];
    return idx ? &mesgs[idx - 1] : NULL;
}
```