Cached the base type, used a direct data pointer, and replaced the byte loop with constant-size `memcpy` loads for common base sizes (falling back to the original loop when `size > sizeof(T)`).
```include
#include <cstring>
```
```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;
    const FIT_UINT8 size = baseTypeSizes[type];
    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
    }

    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);

    if (size > sizeof(T))
    {
        T rv = 0;
        for (int i = 0; i < size; i++)
        {
            rv |= static_cast<T>(p[i]) << (i * 8);
        }
        return rv;
    }

    T rv = 0;
    switch (size)
    {
    case 0:
        return rv;
    case 1:
        return static_cast<T>(p[0]);
    case 2:
        std::memcpy(&rv, p, 2);
        break;
    case 4:
        std::memcpy(&rv, p, 4);
        break;
    case 8:
        std::memcpy(&rv, p, 8);
        break;
    default:
        std::memcpy(&rv, p, size);
        break;
    }

    return rv;
}
```