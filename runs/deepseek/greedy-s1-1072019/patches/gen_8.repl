I reordered the type dispatch into a frequency-ordered if/else chain and skipped the division/subtraction when the scale is 1.0 and offset is 0.0 (while preserving NaN behavior), which removes a costly division on most fields. I also read FLOAT64 values directly via `GetValue<FIT_FLOAT64>` to avoid an extra memcpy.

```cpp
FIT_FLOAT64 FieldBase::GetFLOAT64Value(const FIT_UINT8 fieldArrayIndex, const FIT_UINT16 subFieldIndex) const
{
    if (!IsValid())
        return FIT_FLOAT64_INVALID;

    const FIT_UINT8 type = GetType();
    FIT_FLOAT64 float64Value;

    if (type == FIT_BASE_TYPE_UINT32 || type == FIT_BASE_TYPE_UINT32Z)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_UINT32>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_UINT16 || type == FIT_BASE_TYPE_UINT16Z)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_UINT16>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_UINT8 || type == FIT_BASE_TYPE_UINT8Z)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_UINT8>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_SINT32)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_SINT32>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_ENUM)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_ENUM>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_SINT8)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_SINT8>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_SINT16)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_SINT16>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else if (type == FIT_BASE_TYPE_FLOAT32)
    {
        FIT_FLOAT32 val = GetFLOAT32Value(fieldArrayIndex, subFieldIndex);

        if (FIT_FLOAT32_INVALID == val)
        {
            return FIT_FLOAT64_INVALID;
        }

        return static_cast<FIT_FLOAT64>(val);
    }
    else if (type == FIT_BASE_TYPE_FLOAT64)
    {
        float64Value = GetValue<FIT_FLOAT64>(fieldArrayIndex);
    }
    else if (type == FIT_BASE_TYPE_BYTE)
    {
        float64Value = ConvertBaseType<FIT_FLOAT64, FIT_BYTE>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
    }
    else
    {
        return FIT_FLOAT64_INVALID;
    }

    if (memcmp(&float64Value, baseTypeInvalids[FIT_BASE_TYPE_FLOAT64 & FIT_BASE_TYPE_NUM_MASK], sizeof(FIT_FLOAT64)) == 0)
    {
        return float64Value;
    }

    const FIT_FLOAT64 scale = GetScale(subFieldIndex);
    const FIT_FLOAT64 offset = GetOffset(subFieldIndex);

    if (scale == 1.0 && offset == 0.0 && float64Value == float64Value)
    {
        return float64Value;
    }

    return float64Value / scale - offset;
}
```