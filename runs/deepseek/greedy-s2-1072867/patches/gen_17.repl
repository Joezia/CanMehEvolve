I replaced the runtime size switch with compile-time dispatch on `sizeof(T)`, so the common matching base-type case performs a single sized load and avoids the switch. I also added an integral fast path that reads only the necessary bytes, reducing branches and memory traffic.

```include
#include <type_traits>
```

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;

    if (fieldArrayIndex >= static_cast<FIT_UINT8>(values.size()))
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
    }

    const FIT_UINT8 size = baseTypeSizes[type];
    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);

    if constexpr (std::is_integral<T>::value && !std::is_same<T, bool>::value)
    {
        if constexpr (sizeof(T) == 1)
        {
            return static_cast<T>(p[0]);
        }
        else if constexpr (sizeof(T) == 2)
        {
            if (size >= 2)
            {
                FIT_UINT16 v;
                std::memcpy(&v, p, 2);
                return static_cast<T>(v);
            }
            return static_cast<T>(p[0]);
        }
        else if constexpr (sizeof(T) == 4)
        {
            if (size >= 4)
            {
                FIT_UINT32 v;
                std::memcpy(&v, p, 4);
                return static_cast<T>(v);
            }
            if (size >= 2)
            {
                FIT_UINT16 v;
                std::memcpy(&v, p, 2);
                return static_cast<T>(v);
            }
            return static_cast<T>(p[0]);
        }
        else if constexpr (sizeof(T) == 8)
        {
            if (size >= 8)
            {
                FIT_UINT64 v;
                std::memcpy(&v, p, 8);
                return static_cast<T>(v);
            }
            if (size >= 4)
            {
                FIT_UINT32 v;
                std::memcpy(&v, p, 4);
                return static_cast<T>(v);
            }
            if (size >= 2)
            {
                FIT_UINT16 v;
                std::memcpy(&v, p, 2);
                return static_cast<T>(v);
            }
            return static_cast<T>(p[0]);
        }
    }

    FIT_UINT64 rv = 0;

    switch (size)
    {
    case 1:
        rv = p[0];
        break;
    case 2:
        std::memcpy(&rv, p, 2);
        break;
    case 4:
        std::memcpy(&rv, p, 4);
        break;
    case 8:
        std::memcpy(&rv, p, 8);
        break;
    default:
        for (int i = 0; i < size; ++i)
        {
            rv |= static_cast<FIT_UINT64>(p[i]) << (i * 8);
        }
        break;
    }

    return static_cast<T>(rv);
}
```