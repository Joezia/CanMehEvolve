Changed the linear scan to a one-time built 65536-entry pointer lookup table, so each `GetMesg` call becomes a single array access. The table preserves first-match semantics for duplicate message numbers and returns `NULL` for absent numbers.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const Profile::MESG* lookup[65536] = {};
    static bool initialized = false;

    if (!initialized)
    {
        for (int i = 0; i < MESGS; i++)
        {
            const FIT_UINT16 n = mesgs[i].num;
            if (lookup[n] == NULL)
                lookup[n] = &mesgs[i];
        }
        initialized = true;
    }

    return lookup[num];
}
```