I added fast paths for the two hottest cases—1-byte base types and base-type size equal to `sizeof(T)`—so the switch/jump table is bypassed for most fields while preserving exact original semantics.

```include
#include <cstring>
#include <type_traits>
```

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;

    if (fieldArrayIndex >= static_cast<FIT_UINT8>(values.size()))
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
    }

    const FIT_UINT8 size = baseTypeSizes[type];
    const FIT_UINT8* const p = values.data() + (fieldArrayIndex * size);

    if (size == 1)
    {
        return static_cast<T>(p[0]);
    }

    if constexpr (std::is_integral<T>::value)
    {
        if (size == sizeof(T))
        {
            FIT_UINT64 rv = 0;
            std::memcpy(&rv, p, sizeof(T));
            return static_cast<T>(rv);
        }
    }

    FIT_UINT64 rv = 0;

    switch (size)
    {
    case 2:
        std::memcpy(&rv, p, 2);
        break;
    case 4:
        std::memcpy(&rv, p, 4);
        break;
    case 8:
        std::memcpy(&rv, p, 8);
        break;
    default:
        for (int i = 0; i < size; ++i)
        {
            rv |= static_cast<FIT_UINT64>(p[i]) << (i * 8);
        }
        break;
    }

    return static_cast<T>(rv);
}
```