I inlined the type-specific setters and replaced the FLOAT64 byte-copy loop with `memcpy`, and I moved the `Round` call into only the cases that actually use it. This removes redundant rounding for 64-bit/float64 fields and avoids repeated setter calls.

```cpp
void FieldBase::AddRawValue(const FIT_FLOAT64 rawValue, const FIT_UINT8 fieldArrayIndex)
{
    switch ( GetType() )
    {
        case FIT_BASE_TYPE_BYTE:
        case FIT_BASE_TYPE_ENUM:
        case FIT_BASE_TYPE_SINT8:
        case FIT_BASE_TYPE_UINT8:
        case FIT_BASE_TYPE_UINT8Z:
        {
            FIT_FLOAT64 roundedValue = FieldBase::Round(rawValue);
            FIT_UINT8 value = (FIT_UINT8)roundedValue;
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_UINT8)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_UINT8));
            }
            values[fieldArrayIndex * sizeof(FIT_UINT8)] = value;
            break;
        }

        case FIT_BASE_TYPE_SINT16:
        case FIT_BASE_TYPE_UINT16:
        case FIT_BASE_TYPE_UINT16Z:
        {
            FIT_FLOAT64 roundedValue = FieldBase::Round(rawValue);
            FIT_UINT16 value = (FIT_UINT16)roundedValue;
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_UINT16)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_UINT16));
            }
            memcpy(&values[fieldArrayIndex * sizeof(FIT_UINT16)], &value, sizeof(FIT_UINT16));
            break;
        }

        case FIT_BASE_TYPE_SINT32:
        case FIT_BASE_TYPE_UINT32:
        case FIT_BASE_TYPE_UINT32Z:
        {
            FIT_FLOAT64 roundedValue = FieldBase::Round(rawValue);
            FIT_UINT32 value = (FIT_UINT32)roundedValue;
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_UINT32)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_UINT32));
            }
            memcpy(&values[fieldArrayIndex * sizeof(FIT_UINT32)], &value, sizeof(FIT_UINT32));
            break;
        }

        case FIT_BASE_TYPE_FLOAT32:
        {
            FIT_FLOAT64 roundedValue = FieldBase::Round(rawValue);
            FIT_FLOAT32 value = (FIT_FLOAT32)roundedValue;
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_FLOAT32)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_FLOAT32));
            }
            memcpy(&values[fieldArrayIndex * sizeof(FIT_FLOAT32)], &value, sizeof(FIT_FLOAT32));
            break;
        }

        case FIT_BASE_TYPE_FLOAT64:
        {
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_FLOAT64)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_FLOAT64));
            }
            memcpy(&values[fieldArrayIndex * sizeof(FIT_FLOAT64)], &rawValue, sizeof(FIT_FLOAT64));
            break;
        }

        case FIT_BASE_TYPE_SINT64:
        {
            FIT_SINT64 value = (FIT_SINT64)rawValue;
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_SINT64)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_SINT64));
            }
            memcpy(&values[fieldArrayIndex * sizeof(FIT_SINT64)], &value, sizeof(FIT_SINT64));
            break;
        }

        case FIT_BASE_TYPE_UINT64:
        case FIT_BASE_TYPE_UINT64Z:
        {
            FIT_UINT64 value = (FIT_UINT64)rawValue;
            if ((FIT_UINT8)values.size() < ((fieldArrayIndex + 1) * sizeof(FIT_UINT64)))
            {
                values.resize((fieldArrayIndex + 1) * sizeof(FIT_UINT64));
            }
            memcpy(&values[fieldArrayIndex * sizeof(FIT_UINT64)], &value, sizeof(FIT_UINT64));
            break;
        }

        default:
            break;
    }
}
```