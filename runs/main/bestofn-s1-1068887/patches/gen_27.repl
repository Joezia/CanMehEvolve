#include <algorithm>
#include <vector>

```cpp
const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
{
    const MESG *mesg = GetMesg(mesgNum);

    if (mesg == NULL)
        return FIT_UINT16_INVALID;

    // Binary search if fields are sorted (common case in FIT profile)
    // Use lower_bound on the assumption fields are sorted by num (as per FIT spec)
    auto it = std::lower_bound(mesg->fields, mesg->fields + mesg->numFields,
        fieldNum, [](const FIELD& f, FIT_UINT8 num) { return f.num < num; });
    
    if (it != mesg->fields + mesg->numFields && it->num == fieldNum)
        return static_cast<FIT_UINT16>(std::distance(mesg->fields, it));
    
    return FIT_UINT16_INVALID;
}
```