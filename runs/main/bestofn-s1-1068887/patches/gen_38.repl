```cpp
#include <cstdint>

template <typename T>
T FieldBase::GetBitsValueT(const FIT_UINT16 offset, const FIT_UINT8 bits) const
{
    if (values.empty())
        return FitInvalid<T>::value;

    T value = 0;
    FIT_UINT8 bits_read = 0;
    FIT_UINT8 byte_index = offset / 8;
    FIT_UINT8 bit_offset = offset % 8;

    while (bits_read < bits)
    {
        if (byte_index >= GetSize())
            return FitInvalid<T>::value;

        FIT_UINT8 data = GetValuesUINT8(byte_index);
        data >>= bit_offset;

        FIT_UINT8 available_bits = 8 - bit_offset;
        FIT_UINT8 needed_bits = bits - bits_read;
        FIT_UINT8 copy_bits = available_bits < needed_bits ? available_bits : needed_bits;

        value |= (T)(data & ((1U << copy_bits) - 1U)) << bits_read;

        bits_read += copy_bits;
        bit_offset = 0;
        byte_index++;
    }

    return value;
}
```