#include <algorithm>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const auto compare_by_num = [](const MESG& a, const MESG& b) { return a.num < b.num; };
    static const MESG* sorted_mesgs = nullptr;
    static bool sorted = false;
    
