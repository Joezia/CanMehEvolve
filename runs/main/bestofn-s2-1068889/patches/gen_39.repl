```cpp
#include <algorithm>

const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
{
    const MESG *mesg = GetMesg(mesgNum);

    if (mesg == NULL)
        return FIT_UINT16_INVALID;

    // Binary search assumes fields are sorted by num (profile guarantees this)
    const Field *fields = mesg->fields;
    FIT_UINT16 left = 0;
    FIT_UINT16 right = mesg->numFields;

    while (left < right) {
        FIT_UINT16 mid = left + ((right - left) >> 1);
        FIT_UINT8 midVal = fields[mid].num;

        if (midVal < fieldNum) {
            left = mid + 1;
        } else if (midVal > fieldNum) {
            right = mid;
        } else {
            return mid;
        }
    }

    return FIT_UINT16_INVALID;
}
```