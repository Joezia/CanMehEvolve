```cpp
#include <cstring>
#include <cmath>

FIT_FLOAT64 FieldBase::GetFLOAT64Value(const FIT_UINT8 fieldArrayIndex, const FIT_UINT16 subFieldIndex) const
{
    if (!IsValid())
        return FIT_FLOAT64_INVALID;

    const FIT_BASE_TYPE type = GetType();
    FIT_FLOAT64 result;

    switch (type) {
        case FIT_BASE_TYPE_FLOAT64: {
            FIT_UINT64 uint64Value = GetValue<FIT_UINT64>(fieldArrayIndex);
            memcpy(&result, &uint64Value, sizeof(FIT_FLOAT64));
            break;
        }
        case FIT_BASE_TYPE_FLOAT32: {
            FIT_FLOAT32 val = GetFLOAT32Value(fieldArrayIndex, subFieldIndex);
            if (val == FIT_FLOAT32_INVALID)
                return FIT_FLOAT64_INVALID;
            return static_cast<FIT_FLOAT64>(val);
        }
        case FIT_BASE_TYPE_BYTE:
        case FIT_BASE_TYPE_ENUM:
        case FIT_BASE_TYPE_SINT8:
        case FIT_BASE_TYPE_UINT8:
        case FIT_BASE_TYPE_UINT8Z:
        case FIT_BASE_TYPE_SINT16:
        case FIT_BASE_TYPE_UINT16:
        case FIT_BASE_TYPE_UINT16Z:
        case FIT_BASE_TYPE_SINT32:
        case FIT_BASE_TYPE_UINT32:
        case FIT_BASE_TYPE_UINT32Z: {
            result = ConvertBaseType<FIT_FLOAT64, int>(fieldArrayIndex, type);
            break;
        }
        default:
            return FIT_FLOAT64_INVALID;
    }

    // Check for invalid value using direct bit comparison (faster than memcmp)
    const FIT_UINT64* invalidBits = reinterpret_cast<const FIT_UINT64*>(baseTypeInvalids[type & FIT_BASE_TYPE_NUM_MASK]);
    FIT_UINT64 resultBits;
    memcpy(&resultBits, &result, sizeof(FIT_FLOAT64));

    if (resultBits == *invalidBits) {
        return result;
    }

    // Apply scale/offset only when needed (avoid division when scale=1 and offset=0)
    const FIT_FLOAT64 scale = GetScale(subFieldIndex);
    const FIT_FLOAT64 offset = GetOffset(subFieldIndex);
    if (scale == 1.0 && offset == 0.0) {
        return result;
    }
    return result / scale - offset;
}
```