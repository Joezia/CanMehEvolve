```cpp
#include <algorithm>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const auto less_by_num = [](const MESG& a, const MESG& b) { return a.num < b.num; };
    static const bool sorted = std::is_sorted(mesgs, mesgs + MESGS, less_by_num);
    if (!sorted) {
        for (int i = 0; i < MESGS; i++)
            if (mesgs[i].num == num)
                return &mesgs[i];
        return NULL;
    }
    auto it = std::lower_bound(mesgs, mesgs + MESGS, num, [](const MESG& a, FIT_UINT16 n) { return a.num < n; });
    if (it != mesgs + MESGS && it->num == num)
        return it;
    return NULL;
}
```