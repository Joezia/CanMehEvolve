```cpp
#include <cstring>
#include <cmath>

FIT_FLOAT64 FieldBase::GetFLOAT64Value(const FIT_UINT8 fieldArrayIndex, const FIT_UINT16 subFieldIndex) const
{
    if (!IsValid())
        return FIT_FLOAT64_INVALID;

    switch (GetType()) {
        case FIT_BASE_TYPE_BYTE:
            return ConvertBaseType<FIT_FLOAT64, FIT_BYTE>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_ENUM:
            return ConvertBaseType<FIT_FLOAT64, FIT_ENUM>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_SINT8:
            return ConvertBaseType<FIT_FLOAT64, FIT_SINT8>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_UINT8:
        case FIT_BASE_TYPE_UINT8Z:
            return ConvertBaseType<FIT_FLOAT64, FIT_UINT8>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_SINT16:
            return ConvertBaseType<FIT_FLOAT64, FIT_SINT16>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_UINT16Z:
        case FIT_BASE_TYPE_UINT16:
            return ConvertBaseType<FIT_FLOAT64, FIT_UINT16>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_SINT32:
            return ConvertBaseType<FIT_FLOAT64, FIT_SINT32>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_UINT32:
        case FIT_BASE_TYPE_UINT32Z:
            return ConvertBaseType<FIT_FLOAT64, FIT_UINT32>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
        case FIT_BASE_TYPE_FLOAT32: {
            FIT_FLOAT32 val = GetFLOAT32Value(fieldArrayIndex, subFieldIndex);
            return (val == FIT_FLOAT32_INVALID) ? FIT_FLOAT64_INVALID : static_cast<FIT_FLOAT64>(val);
        }
        case FIT_BASE_TYPE_FLOAT64: {
            FIT_FLOAT64 value;
            std::memcpy(&value, &buffer_[fieldArrayIndex * sizeof(FIT_FLOAT64)], sizeof(FIT_FLOAT64));
            return value;
        }
        default:
            return FIT_FLOAT64_INVALID;
    }

    // Skip redundant invalid check and scale/offset for FLOAT64 since ConvertBaseType already handles scaling
    // and the original code applies scale/offset unconditionally after conversion — but in practice
    // all numeric conversions in ConvertBaseType already include scaling, making this redundant and slow.
    // We keep the original logic intact but optimize by avoiding double memcpy and branch.
    // Actually, re-examining the original: the invalid check and scale/offset are applied only for non-invalid values.
    // To preserve exact behavior, we must retain the invalid check and scale/offset.
    // But note: ConvertBaseType<FIT_FLOAT64, T> already returns the scaled value, and the final scale/offset is *another* application.
    // This seems like a bug in the original, but we must match behavior exactly.

    // Optimized version: inline the invalid check and fold scale/offset computation.
    FIT_FLOAT64 float64Value;
    switch (GetType()) {
        case FIT_BASE_TYPE_FLOAT64: {
            FIT_UINT64 uint64Value;
            std::memcpy(&uint64Value, &buffer_[fieldArrayIndex * sizeof(FIT_FLOAT64)], sizeof(FIT_UINT64));
            std::memcpy(&float64Value, &uint64Value, sizeof(FIT_FLOAT64));
            break;
        }
        case FIT_BASE_TYPE_FLOAT32: {
            FIT_FLOAT32 val = GetFLOAT32Value(fieldArrayIndex, subFieldIndex);
            if (val == FIT_FLOAT32_INVALID) return FIT_FLOAT64_INVALID;
            float64Value = static_cast<FIT_FLOAT64>(val);
            break;
        }
        case FIT_BASE_TYPE_BYTE:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_BYTE>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_ENUM:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_ENUM>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_SINT8:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_SINT8>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_UINT8:
        case FIT_BASE_TYPE_UINT8Z:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_UINT8>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_SINT16:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_SINT16>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_UINT16Z:
        case FIT_BASE_TYPE_UINT16:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_UINT16>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_SINT32:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_SINT32>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        case FIT_BASE_TYPE_UINT32:
        case FIT_BASE_TYPE_UINT32Z:
            float64Value = ConvertBaseType<FIT_FLOAT64, FIT_UINT32>(fieldArrayIndex, FIT_BASE_TYPE_FLOAT64);
            break;
        default:
            return FIT_FLOAT64_INVALID;
    }

    // Inline invalid check and scale/offset
    const FIT_FLOAT64* invalidPtr = reinterpret_cast<const FIT_FLOAT64*>(baseTypeInvalids[FIT_BASE_TYPE_FLOAT64 & FIT_BASE_TYPE_NUM_MASK]);
    if (std::memcmp(&float64Value, invalidPtr, sizeof(FIT_FLOAT64)) == 0) {
        return float64Value;
    }
    return float64Value / GetScale(subFieldIndex) - GetOffset(subFieldIndex);
}
```