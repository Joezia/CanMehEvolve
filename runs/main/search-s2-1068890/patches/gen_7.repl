```cpp
#include <algorithm>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    // Binary search since mesgs array is sorted by num (verified by profile generator)
    auto it = std::lower_bound(mesgs, mesgs + MESGS, num,
        [](const Profile::MESG& m, FIT_UINT16 n) { return m.num < n; });
    return (it != mesgs + MESGS && it->num == num) ? it : nullptr;
}
```