```cpp
#include <algorithm>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    // Binary search assumes mesgs[] is sorted by num (as per FIT spec)
    // Use lower_bound for O(log n) lookup instead of linear O(n)
    auto it = std::lower_bound(mesgs, mesgs + MESGS, num,
        [](const Profile::MESG& m, FIT_UINT16 val) { return m.num < val; });
    if (it != mesgs + MESGS && it->num == num)
        return &*it;
    return NULL;
}
```