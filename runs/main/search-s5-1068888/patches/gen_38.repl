```cpp
#include <algorithm>
#include <array>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static std::array<const Profile::MESG*, 256> cache{};

    if (num < cache.size()) {
        if (const Profile::MESG* cached = cache[num]) {
            return cached;
        }
    }

    // Use std::find_if with structured binding for better branch prediction and early exit
    const auto it = std::find_if(mesgs, mesgs + MESGS,
        [num](const Profile::MESG& m) { return m.num == num; });
    
    if (it != mesgs + MESGS) {
        if (num < cache.size()) {
            cache[num] = &*it;
        }
        return &*it;
    }

    return nullptr;
}
```