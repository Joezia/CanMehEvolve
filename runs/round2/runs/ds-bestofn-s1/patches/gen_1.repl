I added a small static cache for the profile field lookup and inlined the per-message reference-field search, avoiding repeated global profile scans during decoding.

```cpp
FIT_UINT16 Mesg::GetActiveSubFieldIndex(const FIT_UINT8 fieldNum) const
{
    static const Profile::FIELD* fieldCache[1024];
    static FIT_UINT32 fieldKey[1024];

    const FIT_UINT32 key = (((FIT_UINT32)GetNum() + 1) << 8) | fieldNum;
    const FIT_UINT32 slot = (key ^ (key >> 8)) & 1023U;

    const Profile::FIELD* field;
    if (fieldKey[slot] == key)
    {
        field = fieldCache[slot];
    }
    else
    {
        field = Profile::GetField(GetNum(), fieldNum);
        fieldKey[slot] = key;
        fieldCache[slot] = field;
    }

    if (field == FIT_NULL)
        return FIT_SUBFIELD_INDEX_MAIN_FIELD;

    for (FIT_UINT16 i = 0; i < field->numSubFields; i++)
    {
        const Profile::SUBFIELD& subField = field->subFields[i];

        for (FIT_UINT16 j = 0; j < subField.numMaps; j++)
        {
            const FIT_UINT8 refFieldNum = subField.maps[j].refFieldNum;
            const Field* refField = FIT_NULL;

            for (FIT_UINT16 k = 0; k < numFields; k++)
            {
                if (fields[k].GetNum() == refFieldNum)
                {
                    refField = &fields[k];
                    break;
                }
            }

            if (refField != FIT_NULL)
            {
                FIT_FLOAT64 refValue = refField->GetFLOAT64Value(0, FIT_SUBFIELD_INDEX_MAIN_FIELD);
                refValue += ((refValue >= 0.0) ? (0.5) : (-0.5));
                if ((FIT_SINT32)refValue == subField.maps[j].refFieldValue)
                    return i;
            }
        }
    }

    return FIT_SUBFIELD_INDEX_MAIN_FIELD;
}
```