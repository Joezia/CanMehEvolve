Replaced the linear scan with a lazily built 65536-entry direct lookup table, making each call O(1) instead of O(MESGS). The table is built once from the existing `mesgs` array and preserves first-match semantics for duplicate numbers.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    struct Lookup
    {
        const Profile::MESG* table[65536] = {};
        Lookup()
        {
            for (int i = 0; i < MESGS; i++)
            {
                if (table[mesgs[i].num] == NULL)
                    table[mesgs[i].num] = &mesgs[i];
            }
        }
    };
    static Lookup lookup;
    return lookup.table[num];
}
```