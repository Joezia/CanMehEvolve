Cached the base type and replaced the runtime byte loop with a size switch that uses fixed-size `memcpy` loads for 1/2/4/8-byte values, falling back to the original loop only when the target type is narrower than the field. This removes loop overhead and lets the compiler emit single unaligned loads for the common cases.

```include
#include <cstring>
```

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 baseType = GetType() & FIT_BASE_TYPE_NUM_MASK;
    const FIT_UINT8 size = baseTypeSizes[baseType];
    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[baseType]);
    }

    const FIT_UINT8* p = &values[fieldArrayIndex * size];

    switch (size)
    {
    case 1:
        return static_cast<T>(p[0]);
    case 2:
        if constexpr (sizeof(T) >= 2)
        {
            T rv = 0;
            std::memcpy(&rv, p, 2);
            return rv;
        }
        break;
    case 4:
        if constexpr (sizeof(T) >= 4)
        {
            T rv = 0;
            std::memcpy(&rv, p, 4);
            return rv;
        }
        break;
    case 8:
        if constexpr (sizeof(T) >= 8)
        {
            T rv = 0;
            std::memcpy(&rv, p, 8);
            return rv;
        }
        break;
    default:
        break;
    }

    T rv = 0;
    for (int i = 0; i < size; i++)
    {
        rv |= static_cast<T>(p[i]) << (i * 8);
    }
    return rv;
}
```