Cached the base-type lookup and replaced the per-byte shift loop with a size switch using direct byte/memcpy loads, removing repeated `GetType()` calls and loop overhead. A fallback loop preserves identical behavior for any unexpected size.

```include
#include <cstring>
```
```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 type = GetType() & FIT_BASE_TYPE_NUM_MASK;
    const FIT_UINT8 size = baseTypeSizes[type];

    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[type]);
    }

    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);

    switch (size)
    {
    case 1:
        return static_cast<T>(p[0]);
    case 2:
    {
        FIT_UINT16 v;
        std::memcpy(&v, p, 2);
        return static_cast<T>(v);
    }
    case 4:
    {
        FIT_UINT32 v;
        std::memcpy(&v, p, 4);
        return static_cast<T>(v);
    }
    case 8:
    {
        FIT_UINT64 v;
        std::memcpy(&v, p, 8);
        return static_cast<T>(v);
    }
    default:
    {
        T rv = 0;
        for (int i = 0; i < size; i++)
        {
            rv |= static_cast<T>(p[i]) << (i * 8);
        }
        return rv;
    }
    }
}
```