Replaced per-byte pushes with bulk `assign` and reserved capacity for strings, and cached the type while switching on the base type size so common `memcmp` sizes become constant and inlineable. This removes repeated vector reallocations and avoids variable-size `memcmp` calls for typical FIT base types.

```cpp
FIT_BOOL FieldBase::Read(const void *data, const FIT_UINT8 size)
{
    FIT_BYTE *byteData = (FIT_BYTE *) data;
    const FIT_UINT8 type = GetType();

    if (type == FIT_BASE_TYPE_STRING)
    {
        FIT_UINT8 index = 0;
        while (index < size && byteData[index] == 0)
        {
            ++index;
        }

        if (index == size)
        {
            values.clear();
            return FIT_TRUE;
        }

        stringIndexes.push_back(0);

        values.reserve(size + 1);
        values.assign(byteData, byteData + size);

        for (int i = 0; i < (int)size; ++i)
        {
            if (byteData[i] == 0 && i + 2 < (int)size)
            {
                stringIndexes.push_back((FIT_UINT8)(i + 1));
            }
        }

        if (values.back() != 0)
        {
            values.push_back(0);
        }
    }
    else
    {
        const FIT_UINT8 baseType = type & FIT_BASE_TYPE_NUM_MASK;
        const FIT_UINT8 typeSize = baseTypeSizes[baseType];
        const FIT_BYTE *invalid = baseTypeInvalids[baseType];
        int bytes = size;
        const FIT_BYTE *point = byteData;
        FIT_BOOL found = FIT_FALSE;

        switch (typeSize)
        {
            case 1:
                while (bytes > 0)
                {
                    if (*point != *invalid)
                    {
                        found = FIT_TRUE;
                        break;
                    }
                    ++point;
                    --bytes;
                }
                break;

            case 2:
                while (bytes > 0)
                {
                    if (memcmp(point, invalid, 2) != 0)
                    {
                        found = FIT_TRUE;
                        break;
                    }
                    point += 2;
                    bytes -= 2;
                }
                break;

            case 4:
                while (bytes > 0)
                {
                    if (memcmp(point, invalid, 4) != 0)
                    {
                        found = FIT_TRUE;
                        break;
                    }
                    point += 4;
                    bytes -= 4;
                }
                break;

            case 8:
                while (bytes > 0)
                {
                    if (memcmp(point, invalid, 8) != 0)
                    {
                        found = FIT_TRUE;
                        break;
                    }
                    point += 8;
                    bytes -= 8;
                }
                break;

            default:
                while (bytes > 0)
                {
                    if (memcmp(point, invalid, typeSize) != 0)
                    {
                        found = FIT_TRUE;
                        break;
                    }
                    point += typeSize;
                    bytes -= typeSize;
                }
                break;
        }

        if (found)
        {
            values.assign(byteData, byteData + size);
        }
        else
        {
            values.clear();
        }
    }

    return FIT_TRUE;
}
```