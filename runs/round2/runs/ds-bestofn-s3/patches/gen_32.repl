I replaced the linear scan with a lazily built direct lookup table indexed by message number, preserving first-match semantics while making lookups O(1).

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const Profile::MESG* lookup[65536] = {};
    static bool initialized = false;

    if (!initialized)
    {
        for (int i = 0; i < MESGS; i++)
        {
            if (lookup[mesgs[i].num] == NULL)
                lookup[mesgs[i].num] = &mesgs[i];
        }
        initialized = true;
    }

    return lookup[num];
}
```