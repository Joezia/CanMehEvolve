I replaced the linear scan with a one-time-built direct lookup table from message number to `mesgs` index, making every subsequent lookup O(1) and preserving first-match behavior for duplicates.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static FIT_UINT16 lookup[65536] = {};
    static bool initialized = false;

    if (!initialized)
    {
        for (int i = MESGS - 1; i >= 0; --i)
        {
            lookup[mesgs[i].num] = static_cast<FIT_UINT16>(i + 1);
        }
        initialized = true;
    }

    const FIT_UINT16 index = lookup[num];
    return index ? &mesgs[index - 1] : NULL;
}
```