I replaced the linear scan with a lazily built 65536-entry direct lookup table that preserves the original first-match behavior. Each call is then a single indexed load instead of a loop over all messages.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const Profile::MESG* lookup[65536];
    static bool initialized = false;

    if (!initialized)
    {
        for (int i = 0; i < MESGS; i++)
        {
            if (lookup[mesgs[i].num] == NULL)
                lookup[mesgs[i].num] = &mesgs[i];
        }
        initialized = true;
    }

    return lookup[num];
}
```