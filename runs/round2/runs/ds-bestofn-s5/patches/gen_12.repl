I replaced the linear scan with a lazily built direct lookup table that maps each message number to the first matching `MESG` pointer, preserving first-match semantics. This makes each lookup one guard check plus one array access instead of scanning the message table.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const Profile::MESG* table[65536] = {};
    static const bool initialized = [] {
        for (int i = 0; i < Profile::MESGS; ++i)
        {
            const Profile::MESG* m = &Profile::mesgs[i];
            if (table[m->num] == nullptr)
                table[m->num] = m;
        }
        return true;
    }();
    (void)initialized;

    return table[num];
}
```