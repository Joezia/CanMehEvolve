I added a small direct-mapped cache for repeated message numbers and replaced the linear scan with a binary search over the sorted profile message table. This makes repeated lookups (e.g., record messages) O(1) and cold lookups logarithmic instead of linear.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static unsigned cache_tag[256] = { 0 };
    static const Profile::MESG* cache_ptr[256] = { 0 };

    const unsigned idx = num & 0xFFu;
    const unsigned tag = static_cast<unsigned>(num) + 1u;
    if (cache_tag[idx] == tag)
        return cache_ptr[idx];

    int low = 0;
    int high = static_cast<int>(MESGS) - 1;
    const Profile::MESG* result = NULL;
    while (low <= high)
    {
        const int mid = (low + high) >> 1;
        const FIT_UINT16 mid_num = mesgs[mid].num;
        if (mid_num == num)
        {
            result = &mesgs[mid];
            break;
        }
        if (mid_num < num)
            low = mid + 1;
        else
            high = mid - 1;
    }

    cache_tag[idx] = tag;
    cache_ptr[idx] = result;
    return result;
}
```