+                profileIndex = static_cast<FIT_UINT8>(i);
+                break;
+            }
+        }
+    }
+
+    entry.profile = profile;
+    entry.mesgNum = mesgNum;
+    entry.fieldNum = fieldNum;
+    entry.profileIndex = profileIndex;
+    entry.valid = true;
