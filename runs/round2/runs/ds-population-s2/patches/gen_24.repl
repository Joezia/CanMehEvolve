Replaced the 512 KB pointer lookup table with a compact 512-entry direct table for common message numbers and a tiny fallback list for rare high numbers, avoiding large-table cache misses during the full-domain sweep while keeping O(1) common-case lookup.

```cpp
const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static FIT_UINT16 small[512];
    static FIT_UINT16 high[MESGS];
    static FIT_UINT16 high_count = 0;
    static bool initialized = false;
    if (!initialized)
    {
        high_count = 0;
        for (int i = MESGS - 1; i >= 0; --i)
        {
            const FIT_UINT16 n = mesgs[i].num;
            if (n < 512)
                small[n] = static_cast<FIT_UINT16>(i + 1);
            else
                high[high_count++] = static_cast<FIT_UINT16>(i);
        }
        initialized = true;
    }

    if (num < 512)
    {
        const FIT_UINT16 idx = small[num];
        return idx ? &mesgs[idx - 1] : nullptr;
    }

    for (int i = high_count - 1; i >= 0; --i)
    {
        const FIT_UINT16 idx = high[i];
        if (mesgs[idx].num == num)
            return &mesgs[idx];
    }
    return nullptr;
}
```