I cached the base-type lookup once and replaced the runtime shift loop with a fast exact-size `memcpy` path plus small fixed-size fallbacks, preserving the original loop for any mismatched size. This removes repeated `GetType()` calls and loop overhead for the common valid field sizes.

```include
#include <cstring>
```

```cpp
template <typename T>
T FieldBase::GetValue(const FIT_UINT8 fieldArrayIndex) const
{
    const FIT_UINT8 baseType = GetType() & FIT_BASE_TYPE_NUM_MASK;
    if (fieldArrayIndex >= (FIT_UINT8)values.size())
    {
        return *reinterpret_cast<const T*>(baseTypeInvalids[baseType]);
    }

    const FIT_UINT8 size = baseTypeSizes[baseType];
    const FIT_UINT8* p = values.data() + (fieldArrayIndex * size);

    if (size == sizeof(T))
    {
        T rv;
        std::memcpy(&rv, p, sizeof(T));
        return rv;
    }

    if (size == 1)
    {
        return static_cast<T>(p[0]);
    }

    if (size == 2)
    {
        FIT_UINT16 v;
        std::memcpy(&v, p, 2);
        return static_cast<T>(v);
    }

    if (size == 4)
    {
        FIT_UINT32 v;
        std::memcpy(&v, p, 4);
        return static_cast<T>(v);
    }

    T rv = 0;
    for (int i = 0; i < size; i++)
    {
        rv |= static_cast<T>(p[i]) << (i * 8);
    }
    return rv;
}
```