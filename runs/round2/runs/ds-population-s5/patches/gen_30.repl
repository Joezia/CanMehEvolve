Replaced the second profile lookup with an inline scan of the already-fetched message, avoiding a duplicate `Profile::GetMesg` call while preserving the exact index semantics.

```cpp
Field::Field(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
    : FieldBase()
    , profile(Profile::GetMesg(mesgNum))
    , profileIndex(FIT_UINT16_INVALID)
    , type(FIT_UINT8_INVALID)
    , isFieldExpanded(FIT_FALSE)
{
    if (profile != nullptr)
    {
        for (FIT_UINT16 i = 0; i < profile->numFields; ++i)
        {
            if (profile->fields[i].num == fieldNum)
            {
                profileIndex = i;
                break;
            }
        }
    }
}
```