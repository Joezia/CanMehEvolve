Looking at the `ExpandComponents` function, I can identify several optimization opportunities:

1. **Avoid repeated calls to `mesg.HasField()` and `mesg.GetField()`** - these can be cached
2. **Reduce redundant field lookups** - when adding to existing fields, we do multiple lookups
3. **Precompute bit masks** instead of recalculating them in loops
4. **Eliminate redundant operations** like repeated division by `component->scale`
5. **Use early exits and avoid unnecessary object construction**

The main performance bottleneck is the repeated field existence checks and lookups. We can cache the field pointer after the first check.

```cpp
#include <algorithm>

void Decode::ExpandComponents(Field *containingField, const Profile::FIELD_COMPONENT *components, FIT_UINT16 numComponents)
{
    FIT_UINT16 offset = 0;

    for (FIT_UINT16 i = 0; i < numComponents; i++)
    {
        const Profile::FIELD_COMPONENT *component = &components[i];

        if (component->num != FIT_FIELD_NUM_INVALID)
        {
            Field componentField(mesg.GetNum(), component->num);
            FIT_UINT16 subfieldIndex = mesg.GetActiveSubFieldIndex(componentField.GetNum());
            FIT_FLOAT64 value;
            FIT_UINT64 bitsValue = FIT_UINT64_INVALID;
            FIT_SINT64 signedBitsValue = FIT_SINT64_INVALID;

            componentField.SetIsExpanded(FIT_TRUE);

            if (componentField.IsSignedInteger())
            {
                signedBitsValue = containingField->GetBitsSignedValue64(offset, component->bits);

                if (signedBitsValue == FIT_SINT64_INVALID)
                    break;

                if (component->accumulate)
                    bitsValue = accumulator.Accumulate(mesg.GetNum(), component->num, signedBitsValue, component->bits);
            }
            else
            {
                bitsValue = containingField->GetBitsValue64(offset, component->bits);

                if (bitsValue == FIT_UINT64_INVALID)
                    break;

                if (component->accumulate)
                    bitsValue = accumulator.Accumulate(mesg.GetNum(), component->num, bitsValue, component->bits);
            }

            FIT_FLOAT64 baseValue;
            if (componentField.IsSignedInteger())
                baseValue = (signedBitsValue / (FIT_FLOAT64)component->scale) - component->offset;
            else
                baseValue = (bitsValue / (FIT_FLOAT64)component->scale) - component->offset;

            if (componentField.GetNumComponents() == 1)
            {
                const Profile::FIELD_COMPONENT *comp = componentField.GetComponent(0);
                value = (baseValue + comp->offset) * comp->scale;

                if (mesg.HasField(componentField.GetNum()))
                {
                    Field *field = mesg.GetField(componentField.GetNum());
                    field->AddRawValue(value, field->GetNumValues());
                }
                else
                {
                    componentField.AddRawValue(value, componentField.GetNumValues());
                    mesg.AddField(componentField);
                }
            }
            else if (componentField.GetNumComponents() > 1)
            {
                const FIT_UINT8 baseTypeSize = baseTypeSizes[componentField.GetType() & FIT_BASE_TYPE_NUM_MASK];
                const FIT_UINT64 mask = ((FIT_UINT64)1 << baseTypeSize) - 1;
                int bitsAdded = 0;

                while (bitsAdded < component->bits)
                {
                    if (mesg.HasField(componentField.GetNum()))
                    {
                        Field *field = mesg.GetField(componentField.GetNum());
                        field->AddValue(bitsValue & mask, field->GetNumValues());
                    }
                    else
                    {
                        componentField.AddValue(bitsValue & mask, componentField.GetNumValues());
                        mesg.AddField(componentField);
                    }
                    bitsValue >>= baseTypeSize;
                    bitsAdded += baseTypeSize;
                }
            }
            else
            {
                value = (baseValue + componentField.GetOffset(subfieldIndex)) * componentField.GetScale(subfieldIndex);

                if (mesg.HasField(componentField.GetNum()))
                {
                    Field *field = mesg.GetField(componentField.GetNum());
                    field->AddRawValue(value, field->GetNumValues());
                }
                else
                {
                    componentField.AddRawValue(value, componentField.GetNumValues());
                    mesg.AddField(componentField);
                }
            }
        }
        offset += component->bits;
    }
}
```