```cpp
#include <cstdint>

FIT_UINT8 FieldBase::GetNumValues(void) const
{
    if (!IsValid())
        return 0;

    const FIT_BASE_TYPE type = GetType();
    if (type != FIT_BASE_TYPE_STRING)
        return static_cast<FIT_UINT8>(values.size() / baseTypeSizes[type & FIT_BASE_TYPE_NUM_MASK]);

    return static_cast<FIT_UINT8>(stringIndexes.size());
}
```