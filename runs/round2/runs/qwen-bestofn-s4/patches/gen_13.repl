```cpp
const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
{
    static FIT_UINT16 lookup[256][256] = {};
    static bool initialized = false;
    
    if (!initialized) {
        std::memset(lookup, 0xFF, sizeof(lookup));
        initialized = true;
    }
    
    if (lookup[mesgNum][fieldNum] != 0xFFFF) {
        return lookup[mesgNum][fieldNum];
    }
    
    const MESG *mesg = GetMesg(mesgNum);
    
    if (mesg == NULL) {
        lookup[mesgNum][fieldNum] = FIT_UINT16_INVALID;
        return FIT_UINT16_INVALID;
    }
    
    FIT_UINT16 result = FIT_UINT16_INVALID;
    for (FIT_UINT16 i = 0; i < mesg->numFields; i++) {
        if (mesg->fields[i].num == fieldNum) {
            result = i;
            break;
        }
    }
    
    lookup[mesgNum][fieldNum] = result;
    return result;
}
```