+    // Linear search is efficient for small field counts (< ~10), but we can do better:
+    // Profile data is static and sorted by field number per message type in practice.
+    // Use binary search for O(log n) lookup instead of O(n).
+    const FIT_FIELD *fields = mesg->fields;
+    FIT_UINT16 left = 0;
+    FIT_UINT16 right = mesg->numFields;
+
+    while (left < right)
     {
