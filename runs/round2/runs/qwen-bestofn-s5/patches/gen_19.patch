+        FIT_UINT16 mid = left + ((right - left) >> 1);
+        if (fields[mid].num < fieldNum)
+            left = mid + 1;
+        else if (fields[mid].num > fieldNum)
+            right = mid;
+        else
+            return mid;
     }
 
     return FIT_UINT16_INVALID;
