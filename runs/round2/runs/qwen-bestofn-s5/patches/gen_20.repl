```cpp
#include <algorithm>

const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
{
    const MESG *mesg = GetMesg(mesgNum);

    if (mesg == NULL)
        return FIT_UINT16_INVALID;

    // Binary search if fields are sorted by num (common in profile data)
    // Assuming fields are sorted by 'num' field (as per FIT spec)
    const FIELD *fields = mesg->fields;
    FIT_UINT16 left = 0;
    FIT_UINT16 right = mesg->numFields;

    while (left < right) {
        FIT_UINT16 mid = left + ((right - left) >> 1);
        FIT_UINT8 mid_val = fields[mid].num;

        if (mid_val < fieldNum) {
            left = mid + 1;
        } else if (mid_val > fieldNum) {
            right = mid;
        } else {
            return mid;
        }
    }

    return FIT_UINT16_INVALID;
}
```