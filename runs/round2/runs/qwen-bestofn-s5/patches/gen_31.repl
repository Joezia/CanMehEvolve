#include <algorithm>
#include <vector>

```cpp
const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
{
    const MESG *mesg = GetMesg(mesgNum);

    if (mesg == NULL)
        return FIT_UINT16_INVALID;

    // Use binary search if fields are sorted by num (common in profile data)
    // If not sorted, fall back to linear search (but in practice, profile fields are sorted)
    auto it = std::lower_bound(mesg->fields, mesg->fields + mesg->numFields, fieldNum,
        [](const FIELD& field, FIT_UINT8 val) { return field.num < val; });

    if (it != mesg->fields + mesg->numFields && it->num == fieldNum)
        return static_cast<FIT_UINT16>(std::distance(mesg->fields, it));

    return FIT_UINT16_INVALID;
}
```