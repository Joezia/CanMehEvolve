```cpp
#include <algorithm>
#include <vector>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const auto sorted = [] {
        std::vector<const Profile::MESG*> v;
        for (int i = 0; i < MESGS; i++) {
            v.push_back(&mesgs[i]);
        }
        std::sort(v.begin(), v.end(), [](const Profile::MESG* a, const Profile::MESG* b) {
            return a->num < b->num;
        });
        return v;
    }();

    const auto it = std::lower_bound(sorted.begin(), sorted.end(), num,
        [](const Profile::MESG* m, FIT_UINT16 n) { return m->num < n; });
    return (it != sorted.end() && (*it)->num == num) ? *it : nullptr;
}
```