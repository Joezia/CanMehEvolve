```cpp
#include <algorithm>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    static const auto cmp = [](const Profile::MESG& a, const Profile::MESG& b) { return a.num < b.num; };
    static bool sorted = false;
    if (!sorted) {
        std::sort(mesgs, mesgs + MESGS, cmp);
        sorted = true;
    }
    auto it = std::lower_bound(mesgs, mesgs + MESGS, num, [](const Profile::MESG& a, FIT_UINT16 val) { return a.num < val; });
    if (it != mesgs + MESGS && it->num == num) return &(*it);
    return NULL;
}
```