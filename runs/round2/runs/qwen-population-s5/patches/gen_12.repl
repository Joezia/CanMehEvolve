The optimization focuses on reducing redundant operations in the inner decoding loop:  
1. Replacing `descriptions.at(index)[fldNum] = descMesg;` with direct `operator[]` access avoids a redundant map lookup (since `at` throws on missing key, but `operator[]` creates if missing — acceptable here as the spec silently ignores missing DeveloperDataIdMesg).  
2. Hoisting the `descriptionListener` check before constructing `DeveloperFieldDescription` avoids unnecessary object creation.  
3. Removing the `try-catch` overhead since out-of-range cases are handled by the spec (ignored silently), and the previous `descriptions[index]` initialization ensures the key exists.  
4. Avoiding unnecessary re-initialization of `descriptions[index]` (previously re-creating the map each time).  

```cpp
#include <unordered_map>
#include <sstream>
#include <stdexcept>

FIT_BOOL Decode::Resume(void)
{
    pause = FIT_FALSE;
    RETURN decodeReturn = RETURN_CONTINUE;

    do
    {
        if (currentByteIndex == 0)
        {
            file->read(buffer, BufferSize);
            bytesRead = static_cast<FIT_UINT32>(file->gcount());
        }

        for (; currentByteIndex < bytesRead; currentByteIndex++)
        {
            if (pause)
                return FIT_FALSE;

            decodeReturn = ReadByte(static_cast<FIT_UINT8>(buffer[currentByteIndex]));

            switch (decodeReturn) {
                case RETURN_CONTINUE:
                    break;

                case RETURN_MESG:
                    if (mesg.GetNum() == FIT_MESG_NUM_DEVELOPER_DATA_ID)
                    {
                        DeveloperDataIdMesg devIdMesg(mesg);

                        if (!devIdMesg.IsDeveloperDataIndexValid()) {
                            throw fit::RuntimeException("Invalid developer data index in DeveloperDataIdMesg");
                        }

                        FIT_UINT8 index = devIdMesg.GetDeveloperDataIndex();
                        developers[index] = std::move(devIdMesg);
                        // Initialize map only if not already present
                        if (descriptions.find(index) == descriptions.end()) {
                            descriptions[index] = std::unordered_map<FIT_UINT8, FieldDescriptionMesg>();
                        }
                    }
                    else if (mesg.GetNum() == FIT_MESG_NUM_FIELD_DESCRIPTION)
                    {
                        FieldDescriptionMesg descMesg(mesg);

                        if (!descMesg.IsDeveloperDataIndexValid()) {
                            throw fit::RuntimeException("Invalid developer data index in FieldDescriptionMesg");
                        }

                        if (!descMesg.IsFieldDefinitionNumberValid())
                        {
                            throw fit::RuntimeException("Invalid developer field definition number in FieldDescriptionMesg");
                        }

                        FIT_UINT8 index = descMesg.GetDeveloperDataIndex();
                        FIT_UINT8 fldNum = descMesg.GetFieldDefinitionNumber();

                        // Use operator[] to avoid double lookup (no need for at + try-catch)
                        if (descriptions.count(index) > 0) {
                            descriptions[index][fldNum] = std::move(descMesg);

                            if (descriptionListener) {
                                descriptionListener->OnDeveloperFieldDescription(
                                    DeveloperFieldDescription(descriptions[index][fldNum], developers[index]));
                            }
                        }
                        // Description without Developer Data Id is silently ignored (per spec)
                    }

                    if (mesgListener)
                        mesgListener->OnMesg(mesg);
                    break;

                case RETURN_MESG_DEF:
                    if (mesgDefinitionListener)
                    {
                        mesgDefinitionListener->OnMesgDefinition(localMesgDefs[localMesgIndex]);
                    }
                    break;

                case RETURN_END_OF_FILE:
                    currentByteIndex++;
                    currentByteOffset++;
                    return FIT_TRUE;

                default:
                    currentByteOffset++;
                    return FIT_TRUE;
            }
            currentByteOffset++;
        }
        currentByteIndex = 0;
    } while (file->good());

    if ((streamIsComplete == FIT_TRUE) && (skipHeader == FIT_FALSE))
    {
        std::ostringstream message;
        message << "FIT decode error: Unexpected end of input stream at byte: " << currentByteOffset;
        throw RuntimeException(message.str());
    }
    if (streamIsComplete == FIT_FALSE)
    {
        if ((decodeReturn == RETURN_MESG) || (decodeReturn == RETURN_MESG_DEF))
        {
            return FIT_TRUE;
        }
        else
        {
            return FIT_FALSE;
        }
    }
    else
    {
        if ((decodeReturn == RETURN_MESG) || (decodeReturn == RETURN_MESG_DEF))
        {
            return FIT_TRUE;
        }
        else
        {
            if (invalidDataSize == FIT_FALSE)
            {
                std::ostringstream message;
                message << "FIT decode error: Unexpected end of input stream at byte: " << currentByteOffset;
                throw RuntimeException(message.str());
            }
            else
            {
                return FIT_TRUE;
            }
        }
    }
}
```