#include <algorithm>
#include <vector>

const Profile::MESG* Profile::GetMesg(const FIT_UINT16 num)
{
    // Binary search on sorted mesgs array (assumed sorted by num per SDK convention)
    static std::vector<const Profile::MESG*> sorted_ptr;
    static bool initialized = false;
    if (!initialized) {
        sorted_ptr.resize(MESGS);
        for (int i = 0; i < MESGS; i++) {
            sorted_ptr[i] = &mesgs[i];
        }
        std::sort(sorted_ptr.begin(), sorted_ptr.end(), [](const Profile::MESG* a, const Profile::MESG* b) {
            return a->num < b->num;
        });
        initialized = true;
    }

