```cpp
#include <algorithm>

const FIT_UINT16 Profile::GetFieldIndex(const FIT_UINT16 mesgNum, const FIT_UINT8 fieldNum)
{
    const MESG *mesg = GetMesg(mesgNum);

    if (mesg == NULL)
        return FIT_UINT16_INVALID;

    // Use binary search if fields are sorted by field number (common in profile data)
    // Assume fields are sorted per specification; if not, fallback to linear search
    // But profile data is typically sorted, so we can safely use binary search
    const FIT_UINT16 *begin = mesg->fields;
    const FIT_UINT16 *end = mesg->fields + mesg->numFields;
    
    // We need a custom comparator for field.num
    struct FieldComparator {
        FIT_UINT8 target;
        FieldComparator(FIT_UINT8 t) : target(t) {}
        bool operator()(const FIT_UINT8& val, const FIT_UINT8& field) const { return val < field; }
        bool operator()(const FIT_UINT8& field, const FIT_UINT8& val) const { return field < val; }
    };

    // Since fields[i].num is FIT_UINT8, we can do binary search on it
    // But the struct is defined as {FIT_UINT8 num; ...} so we need to extract the num field
    // Instead, we use lower_bound with a lambda that extracts num
    auto it = std::lower_bound(mesg->fields, mesg->fields + mesg->numFields, fieldNum,
        [](const FIELD& field, FIT_UINT8 num) { return field.num < num; });

    if (it != mesg->fields + mesg->numFields && it->num == fieldNum)
        return static_cast<FIT_UINT16>(it - mesg->fields);

    return FIT_UINT16_INVALID;
}
```